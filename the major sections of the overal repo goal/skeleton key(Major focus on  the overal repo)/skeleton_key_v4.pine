ext_hist_bar1_C = input.int(0, "Hist Bar 1", minval = 0, group = "═══ EXTERNAL C ═══")
ext_hist_bar2_C = input.int(1, "Hist Bar 2", minval = 0, group = "═══ EXTERNAL C ═══")
