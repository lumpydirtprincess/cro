//@version=6
strategy("Skeleton Key v4 - Diagnostic + Risk Management", "SKE-v4", overlay = true, pyramiding = 5,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     initial_capital = 100000, commission_type = strategy.commission.cash_per_order, commission_value = 0)

// ============================================================================
// STRATEGY SETTINGS
// ============================================================================
stratDirection = input.string("Long", "Strategy Direction", options = ["Long", "Short"], group = "═══ STRATEGY ═══")
showDebugTable = input.bool(true, "Show Debug Table", group = "═══ STRATEGY ═══")
showPerfDash = input.bool(true, "Show Performance Dashboard", group = "═══ STRATEGY ═══")
debugTablePos = input.string("top_right", "Debug Table Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = "═══ STRATEGY ═══")
perfDashPos = input.string("bottom_right", "Perf Dashboard Position", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = "═══ STRATEGY ═══")

// ============================================================================
// RISK MANAGEMENT
// ============================================================================
grpRisk = "═══ RISK MANAGEMENT ═══"
useStopLoss = input.bool(true, "Use Stop Loss", group = grpRisk)
slType = input.string("ATR", "Stop Loss Type", options = ["ATR", "Fixed %", "Swing Low/High"], group = grpRisk)
slATRMult = input.float(1.5, "SL ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk)
slPercent = input.float(1.0, "SL % (Fixed % Type)", minval = 0.1, step = 0.1, group = grpRisk)
slSwingLen = input.int(10, "SL Swing Length (Swing Type)", minval = 1, group = grpRisk)
useTakeProfit = input.bool(true, "Use Take Profit", group = grpRisk)
tpType = input.string("ATR Multiple", "Take Profit Type", options = ["ATR Multiple", "Fixed %", "Risk:Reward"], group = grpRisk)
tpATRMult = input.float(2.0, "TP ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk)
tpPercent = input.float(2.0, "TP % (Fixed % Type)", minval = 0.1, step = 0.1, group = grpRisk)
tpRRRatio = input.float(2.0, "TP Risk:Reward Ratio", minval = 0.5, step = 0.1, group = grpRisk)
useTrailingStop = input.bool(true, "Use Trailing Stop", group = grpRisk)
trailActivationMult = input.float(1.0, "Trail Activation (ATR Mult)", minval = 0.1, step = 0.1, group = grpRisk)
trailOffsetMult = input.float(0.5, "Trail Offset (ATR Mult)", minval = 0.1, step = 0.1, group = grpRisk)
useBreakeven = input.bool(true, "Use Breakeven Stop", group = grpRisk)
beActivationMult = input.float(1.0, "BE Activation (ATR Mult)", minval = 0.1, step = 0.1, group = grpRisk)
beOffsetMult = input.float(0.1, "BE Offset (ATR Mult)", minval = 0.0, step = 0.05, group = grpRisk)
entryCooldownBars = input.int(0, "Entry Cooldown (Bars)", minval = 0, maxval = 50, group = grpRisk)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
f_threshold_compare_enhanced(float src, float src_prev, string op, float val) =>
    switch op
        "<"  => src < val
        ">"  => src > val
        "<=" => src <= val
        ">=" => src >= val
        "==" => src == val
        "rising" => src > src_prev
        "falling" => src < src_prev
        "crosses_above" => src_prev <= val and src > val
        "crosses_below" => src_prev >= val and src < val
        => false

f_external_compare(float src1, string op, float src2, float src1_prev, float src2_prev) =>
    switch op
        "<"  => src1 < src2
        ">"  => src1 > src2
        "<=" => src1 <= src2
        ">=" => src1 >= src2
        "==" => src1 == src2
        "crossover"  => src1_prev < src2_prev and src1 > src2
        "crossunder" => src1_prev > src2_prev and src1 < src2
        => false

f_profit_filter(string filter) =>
    if filter == "ANY"
        true
    else if filter == "PROFIT"
        strategy.position_size != 0 ? strategy.openprofit > 0 : true
    else if filter == "LOSS"
        strategy.position_size != 0 ? strategy.openprofit < 0 : true
        true

// ============================================================================
// THRESHOLD A INPUTS
// ============================================================================
thresh_enabled_A = input.bool(true, "Enable?", group = "═══ THRESHOLD A ═══")
thresh_source_A = input.source(close, "Source", inline = 'threshA', group = "═══ THRESHOLD A ═══")
thresh_operator_A = input.string(">=", "Op", inline = 'threshA', options = ["<", ">", "<=", ">=", "==", "rising", "falling", "crosses_above", "crosses_below"], group = "═══ THRESHOLD A ═══")
thresh_value_A = input.float(0.0, "Val", inline = 'threshA', group = "═══ THRESHOLD A ═══")
thresh_offset_A = input.float(0.0, "Offset %", minval = -100, maxval = 100, step = 0.1, group = "═══ THRESHOLD A ═══")
thresh_hist_bar_A = input.int(0, "Hist Bar Idx", minval = 0, group = "═══ THRESHOLD A ═══")
thresh_bars_valid_A = input.int(0, "Bars Valid", minval = 0, group = "═══ THRESHOLD A ═══")
thresh_profit_filter_A = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ THRESHOLD A ═══")
thresh_entry_A = input.bool(true, "Entry", inline = 'threshA_act', group = "═══ THRESHOLD A ═══")
thresh_exit_A = input.bool(false, "Exit", inline = 'threshA_act', group = "═══ THRESHOLD A ═══")
thresh_entry_logic_A = input.string("AND-A", "Entry Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD A ═══")
thresh_exit_logic_A = input.string("OR", "Exit Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD A ═══")

