ext_operator_D = input.string("crossover", "Op", inline = 'extD', options = ["<", ">", "<=", ">=", "==", "crossover", "crossunder"], group = "═══ EXTERNAL D ═══")
ext_source2_D = input.source(open, "Src2", inline = 'extD', group = "═══ EXTERNAL D ═══")
