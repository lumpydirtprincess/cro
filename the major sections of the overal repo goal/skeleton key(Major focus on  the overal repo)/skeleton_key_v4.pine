thresh_profit_filter_C = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ THRESHOLD C ═══")
thresh_entry_C = input.bool(true, "Entry", inline = 'threshC_act', group = "═══ THRESHOLD C ═══")
thresh_exit_C = input.bool(false, "Exit", inline = 'threshC_act', group = "═══ THRESHOLD C ═══")
