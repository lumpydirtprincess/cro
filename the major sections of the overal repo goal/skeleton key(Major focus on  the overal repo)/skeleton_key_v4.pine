ext_hist_bar2_D = input.int(1, "Hist Bar 2", minval = 0, group = "═══ EXTERNAL D ═══")
ext_bars_valid_D = input.int(0, "Bars Valid", minval = 0, group = "═══ EXTERNAL D ═══")
