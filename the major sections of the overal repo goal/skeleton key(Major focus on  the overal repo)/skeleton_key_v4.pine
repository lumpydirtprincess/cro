// ============================================================================
ext_enabled_A = input.bool(true, "Enable?", group = "═══ EXTERNAL A ═══")
ext_source1_A = input.source(close, "Src1", inline = 'extA', group = "═══ EXTERNAL A ═══")
ext_operator_A = input.string("crossover", "Op", inline = 'extA', options = ["<", ">", "<=", ">=", "==", "crossover", "crossunder"], group = "═══ EXTERNAL A ═══")
ext_source2_A = input.source(open, "Src2", inline = 'extA', group = "═══ EXTERNAL A ═══")
ext_offset1_A = input.float(0.0, "Offset1 %", minval = -100, maxval = 100, step = 0.1, group = "═══ EXTERNAL A ═══")
ext_offset2_A = input.float(0.0, "Offset2 %", minval = -100, maxval = 100, step = 0.1, group = "═══ EXTERNAL A ═══")
ext_hist_bar1_A = input.int(0, "Hist Bar 1", minval = 0, group = "═══ EXTERNAL A ═══")
ext_hist_bar2_A = input.int(1, "Hist Bar 2", minval = 0, group = "═══ EXTERNAL A ═══")
ext_bars_valid_A = input.int(0, "Bars Valid", minval = 0, group = "═══ EXTERNAL A ═══")
ext_profit_filter_A = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ EXTERNAL A ═══")
ext_entry_A = input.bool(true, "Entry", inline = 'extA_act', group = "═══ EXTERNAL A ═══")
ext_exit_A = input.bool(false, "Exit", inline = 'extA_act', group = "═══ EXTERNAL A ═══")
ext_entry_logic_A = input.string("AND-A", "Entry Group", options = ["AND-A", "AND-B", "OR"], group = "═══ EXTERNAL A ═══")
ext_exit_logic_A = input.string("OR", "Exit Group", options = ["AND-A", "AND-B", "OR"], group = "═══ EXTERNAL A ═══")

// ============================================================================
// EXTERNAL B INPUTS
// ============================================================================
ext_enabled_B = input.bool(false, "Enable?", group = "═══ EXTERNAL B ═══")
ext_source1_B = input.source(close, "Src1", inline = 'extB', group = "═══ EXTERNAL B ═══")
ext_operator_B = input.string("crossover", "Op", inline = 'extB', options = ["<", ">", "<=", ">=", "==", "crossover", "crossunder"], group = "═══ EXTERNAL B ═══")
ext_source2_B = input.source(open, "Src2", inline = 'extB', group = "═══ EXTERNAL B ═══")
ext_offset1_B = input.float(0.0, "Offset1 %", minval = -100, maxval = 100, step = 0.1, group = "═══ EXTERNAL B ═══")
ext_offset2_B = input.float(0.0, "Offset2 %", minval = -100, maxval = 100, step = 0.1, group = "═══ EXTERNAL B ═══")
ext_hist_bar1_B = input.int(0, "Hist Bar 1", minval = 0, group = "═══ EXTERNAL B ═══")
ext_hist_bar2_B = input.int(1, "Hist Bar 2", minval = 0, group = "═══ EXTERNAL B ═══")
ext_bars_valid_B = input.int(0, "Bars Valid", minval = 0, group = "═══ EXTERNAL B ═══")
ext_profit_filter_B = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ EXTERNAL B ═══")
ext_entry_B = input.bool(true, "Entry", inline = 'extB_act', group = "═══ EXTERNAL B ═══")
ext_exit_B = input.bool(false, "Exit", inline = 'extB_act', group = "═══ EXTERNAL B ═══")
ext_entry_logic_B = input.string("AND-A", "Entry Group", options = ["AND-A", "AND-B", "OR"], group = "═══ EXTERNAL B ═══")
ext_exit_logic_B = input.string("OR", "Exit Group", options = ["AND-A", "AND-B", "OR"], group = "═══ EXTERNAL B ═══")

// ============================================================================
// EXTERNAL C INPUTS
// ============================================================================
ext_enabled_C = input.bool(false, "Enable?", group = "═══ EXTERNAL C ═══")
ext_source1_C = input.source(close, "Src1", inline = 'extC', group = "═══ EXTERNAL C ═══")
ext_operator_C = input.string("crossover", "Op", inline = 'extC', options = ["<", ">", "<=", ">=", "==", "crossover", "crossunder"], group = "═══ EXTERNAL C ═══")
ext_source2_C = input.source(open, "Src2", inline = 'extC', group = "═══ EXTERNAL C ═══")
ext_offset1_C = input.float(0.0, "Offset1 %", minval = -100, maxval = 100, step = 0.1, group = "═══ EXTERNAL C ═══")
