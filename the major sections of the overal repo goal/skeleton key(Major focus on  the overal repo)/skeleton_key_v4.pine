// ============================================================================
// THRESHOLD CALCULATIONS (A-E)
// ============================================================================
thresh_src_val_A = thresh_source_A[thresh_hist_bar_A] * (1 + thresh_offset_A / 100)
thresh_src_prev_A = thresh_source_A[thresh_hist_bar_A + 1] * (1 + thresh_offset_A / 100)
thresh_raw_A = thresh_enabled_A and f_threshold_compare_enhanced(thresh_src_val_A, thresh_src_prev_A, thresh_operator_A, thresh_value_A)
var int thresh_bars_since_true_A = 999999
if thresh_raw_A
    thresh_bars_since_true_A := 0
else
    thresh_bars_since_true_A += 1
thresh_signal_valid_A = thresh_enabled_A and thresh_bars_since_true_A <= thresh_bars_valid_A
thresh_signal_entry_A = thresh_signal_valid_A and thresh_entry_A and f_profit_filter(thresh_profit_filter_A)
thresh_signal_exit_A = thresh_signal_valid_A and thresh_exit_A and f_profit_filter(thresh_profit_filter_A)

thresh_src_val_B = thresh_source_B[thresh_hist_bar_B] * (1 + thresh_offset_B / 100)
thresh_src_prev_B = thresh_source_B[thresh_hist_bar_B + 1] * (1 + thresh_offset_B / 100)
thresh_raw_B = thresh_enabled_B and f_threshold_compare_enhanced(thresh_src_val_B, thresh_src_prev_B, thresh_operator_B, thresh_value_B)
var int thresh_bars_since_true_B = 999999
if thresh_raw_B
    thresh_bars_since_true_B := 0
else
    thresh_bars_since_true_B += 1
thresh_signal_valid_B = thresh_enabled_B and thresh_bars_since_true_B <= thresh_bars_valid_B
thresh_signal_entry_B = thresh_signal_valid_B and thresh_entry_B and f_profit_filter(thresh_profit_filter_B)
thresh_signal_exit_B = thresh_signal_valid_B and thresh_exit_B and f_profit_filter(thresh_profit_filter_B)

thresh_src_val_C = thresh_source_C[thresh_hist_bar_C] * (1 + thresh_offset_C / 100)
thresh_src_prev_C = thresh_source_C[thresh_hist_bar_C + 1] * (1 + thresh_offset_C / 100)
thresh_raw_C = thresh_enabled_C and f_threshold_compare_enhanced(thresh_src_val_C, thresh_src_prev_C, thresh_operator_C, thresh_value_C)
var int thresh_bars_since_true_C = 999999
if thresh_raw_C
    thresh_bars_since_true_C := 0
else
    thresh_bars_since_true_C += 1
thresh_signal_valid_C = thresh_enabled_C and thresh_bars_since_true_C <= thresh_bars_valid_C
thresh_signal_entry_C = thresh_signal_valid_C and thresh_entry_C and f_profit_filter(thresh_profit_filter_C)
thresh_signal_exit_C = thresh_signal_valid_C and thresh_exit_C and f_profit_filter(thresh_profit_filter_C)

thresh_src_val_D = thresh_source_D[thresh_hist_bar_D] * (1 + thresh_offset_D / 100)
thresh_src_prev_D = thresh_source_D[thresh_hist_bar_D + 1] * (1 + thresh_offset_D / 100)
thresh_raw_D = thresh_enabled_D and f_threshold_compare_enhanced(thresh_src_val_D, thresh_src_prev_D, thresh_operator_D, thresh_value_D)
var int thresh_bars_since_true_D = 999999
if thresh_raw_D
    thresh_bars_since_true_D := 0
else
    thresh_bars_since_true_D += 1
thresh_signal_valid_D = thresh_enabled_D and thresh_bars_since_true_D <= thresh_bars_valid_D
thresh_signal_entry_D = thresh_signal_valid_D and thresh_entry_D and f_profit_filter(thresh_profit_filter_D)
thresh_signal_exit_D = thresh_signal_valid_D and thresh_exit_D and f_profit_filter(thresh_profit_filter_D)

thresh_src_val_E = thresh_source_E[thresh_hist_bar_E] * (1 + thresh_offset_E / 100)
thresh_src_prev_E = thresh_source_E[thresh_hist_bar_E + 1] * (1 + thresh_offset_E / 100)
thresh_raw_E = thresh_enabled_E and f_threshold_compare_enhanced(thresh_src_val_E, thresh_src_prev_E, thresh_operator_E, thresh_value_E)
var int thresh_bars_since_true_E = 999999
if thresh_raw_E
    thresh_bars_since_true_E := 0
else
    thresh_bars_since_true_E += 1
thresh_signal_valid_E = thresh_enabled_E and thresh_bars_since_true_E <= thresh_bars_valid_E
thresh_signal_entry_E = thresh_signal_valid_E and thresh_entry_E and f_profit_filter(thresh_profit_filter_E)
thresh_signal_exit_E = thresh_signal_valid_E and thresh_exit_E and f_profit_filter(thresh_profit_filter_E)

// ============================================================================
// EXTERNAL CALCULATIONS (A-D)
// ============================================================================
ext_src1_val_A = ext_source1_A[ext_hist_bar1_A] * (1 + ext_offset1_A / 100)
ext_src2_val_A = ext_source2_A[ext_hist_bar2_A] * (1 + ext_offset2_A / 100)
ext_src1_prev_A = ext_source1_A[ext_hist_bar1_A + 1] * (1 + ext_offset1_A / 100)
ext_src2_prev_A = ext_source2_A[ext_hist_bar2_A + 1] * (1 + ext_offset2_A / 100)
ext_raw_A = ext_enabled_A and f_external_compare(ext_src1_val_A, ext_operator_A, ext_src2_val_A, ext_src1_prev_A, ext_src2_prev_A)
var int ext_bars_since_true_A = 999999
if ext_raw_A
    ext_bars_since_true_A := 0
else
    ext_bars_since_true_A += 1
ext_signal_valid_A = ext_enabled_A and ext_bars_since_true_A <= ext_bars_valid_A
ext_signal_entry_A = ext_signal_valid_A and ext_entry_A and f_profit_filter(ext_profit_filter_A)
ext_signal_exit_A = ext_signal_valid_A and ext_exit_A and f_profit_filter(ext_profit_filter_A)

ext_src1_val_B = ext_source1_B[ext_hist_bar1_B] * (1 + ext_offset1_B / 100)
ext_src2_val_B = ext_source2_B[ext_hist_bar2_B] * (1 + ext_offset2_B / 100)
ext_src1_prev_B = ext_source1_B[ext_hist_bar1_B + 1] * (1 + ext_offset1_B / 100)
ext_src2_prev_B = ext_source2_B[ext_hist_bar2_B + 1] * (1 + ext_offset2_B / 100)
ext_raw_B = ext_enabled_B and f_external_compare(ext_src1_val_B, ext_operator_B, ext_src2_val_B, ext_src1_prev_B, ext_src2_prev_B)
var int ext_bars_since_true_B = 999999
if ext_raw_B
    ext_bars_since_true_B := 0
else
    ext_bars_since_true_B += 1
ext_signal_valid_B = ext_enabled_B and ext_bars_since_true_B <= ext_bars_valid_B
ext_signal_entry_B = ext_signal_valid_B and ext_entry_B and f_profit_filter(ext_profit_filter_B)
ext_signal_exit_B = ext_signal_valid_B and ext_exit_B and f_profit_filter(ext_profit_filter_B)

ext_src1_val_C = ext_source1_C[ext_hist_bar1_C] * (1 + ext_offset1_C / 100)
ext_src2_val_C = ext_source2_C[ext_hist_bar2_C] * (1 + ext_offset2_C / 100)
ext_src1_prev_C = ext_source1_C[ext_hist_bar1_C + 1] * (1 + ext_offset1_C / 100)
ext_src2_prev_C = ext_source2_C[ext_hist_bar2_C + 1] * (1 + ext_offset2_C / 100)
ext_raw_C = ext_enabled_C and f_external_compare(ext_src1_val_C, ext_operator_C, ext_src2_val_C, ext_src1_prev_C, ext_src2_prev_C)
var int ext_bars_since_true_C = 999999
if ext_raw_C
    ext_bars_since_true_C := 0
else
    ext_bars_since_true_C += 1
ext_signal_valid_C = ext_enabled_C and ext_bars_since_true_C <= ext_bars_valid_C
ext_signal_entry_C = ext_signal_valid_C and ext_entry_C and f_profit_filter(ext_profit_filter_C)
ext_signal_exit_C = ext_signal_valid_C and ext_exit_C and f_profit_filter(ext_profit_filter_C)

ext_src1_val_D = ext_source1_D[ext_hist_bar1_D] * (1 + ext_offset1_D / 100)
ext_src2_val_D = ext_source2_D[ext_hist_bar2_D] * (1 + ext_offset2_D / 100)
ext_src1_prev_D = ext_source1_D[ext_hist_bar1_D + 1] * (1 + ext_offset1_D / 100)
ext_src2_prev_D = ext_source2_D[ext_hist_bar2_D + 1] * (1 + ext_offset2_D / 100)
ext_raw_D = ext_enabled_D and f_external_compare(ext_src1_val_D, ext_operator_D, ext_src2_val_D, ext_src1_prev_D, ext_src2_prev_D)
var int ext_bars_since_true_D = 999999
if ext_raw_D
    ext_bars_since_true_D := 0
else
    ext_bars_since_true_D += 1
ext_signal_valid_D = ext_enabled_D and ext_bars_since_true_D <= ext_bars_valid_D
ext_signal_entry_D = ext_signal_valid_D and ext_entry_D and f_profit_filter(ext_profit_filter_D)
ext_signal_exit_D = ext_signal_valid_D and ext_exit_D and f_profit_filter(ext_profit_filter_D)

// ============================================================================
// ENTRY LOGIC GROUPS
// ============================================================================
entry_andA_count = (thresh_entry_A and thresh_entry_logic_A == "AND-A" ? 1 : 0) +
                   (thresh_entry_B and thresh_entry_logic_B == "AND-A" ? 1 : 0) +
                   (thresh_entry_C and thresh_entry_logic_C == "AND-A" ? 1 : 0) +
                   (thresh_entry_D and thresh_entry_logic_D == "AND-A" ? 1 : 0) +
                   (thresh_entry_E and thresh_entry_logic_E == "AND-A" ? 1 : 0) +
                   (ext_entry_A and ext_entry_logic_A == "AND-A" ? 1 : 0) +
                   (ext_entry_B and ext_entry_logic_B == "AND-A" ? 1 : 0) +
                   (ext_entry_C and ext_entry_logic_C == "AND-A" ? 1 : 0) +
                   (ext_entry_D and ext_entry_logic_D == "AND-A" ? 1 : 0)

entry_andB_count = (thresh_entry_A and thresh_entry_logic_A == "AND-B" ? 1 : 0) +
                   (thresh_entry_B and thresh_entry_logic_B == "AND-B" ? 1 : 0) +
                   (thresh_entry_C and thresh_entry_logic_C == "AND-B" ? 1 : 0) +
                   (thresh_entry_D and thresh_entry_logic_D == "AND-B" ? 1 : 0) +
                   (thresh_entry_E and thresh_entry_logic_E == "AND-B" ? 1 : 0) +
                   (ext_entry_A and ext_entry_logic_A == "AND-B" ? 1 : 0) +
                   (ext_entry_B and ext_entry_logic_B == "AND-B" ? 1 : 0) +
                   (ext_entry_C and ext_entry_logic_C == "AND-B" ? 1 : 0) +
                   (ext_entry_D and ext_entry_logic_D == "AND-B" ? 1 : 0)

entry_andA_true = (thresh_signal_entry_A and thresh_entry_logic_A == "AND-A" ? 1 : 0) +
                  (thresh_signal_entry_B and thresh_entry_logic_B == "AND-A" ? 1 : 0) +
                  (thresh_signal_entry_C and thresh_entry_logic_C == "AND-A" ? 1 : 0) +
                  (thresh_signal_entry_D and thresh_entry_logic_D == "AND-A" ? 1 : 0) +
                  (thresh_signal_entry_E and thresh_entry_logic_E == "AND-A" ? 1 : 0) +
                  (ext_signal_entry_A and ext_entry_logic_A == "AND-A" ? 1 : 0) +
                  (ext_signal_entry_B and ext_entry_logic_B == "AND-A" ? 1 : 0) +
                  (ext_signal_entry_C and ext_entry_logic_C == "AND-A" ? 1 : 0) +
                  (ext_signal_entry_D and ext_entry_logic_D == "AND-A" ? 1 : 0)

entry_andB_true = (thresh_signal_entry_A and thresh_entry_logic_A == "AND-B" ? 1 : 0) +
                  (thresh_signal_entry_B and thresh_entry_logic_B == "AND-B" ? 1 : 0) +
                  (thresh_signal_entry_C and thresh_entry_logic_C == "AND-B" ? 1 : 0) +
                  (thresh_signal_entry_D and thresh_entry_logic_D == "AND-B" ? 1 : 0) +
                  (thresh_signal_entry_E and thresh_entry_logic_E == "AND-B" ? 1 : 0) +
                  (ext_signal_entry_A and ext_entry_logic_A == "AND-B" ? 1 : 0) +
                  (ext_signal_entry_B and ext_entry_logic_B == "AND-B" ? 1 : 0) +
                  (ext_signal_entry_C and ext_entry_logic_C == "AND-B" ? 1 : 0) +
                  (ext_signal_entry_D and ext_entry_logic_D == "AND-B" ? 1 : 0)

entry_andA_trigger = entry_andA_count > 0 and entry_andA_true == entry_andA_count
entry_andB_trigger = entry_andB_count > 0 and entry_andB_true == entry_andB_count

entry_or_trigger = (thresh_signal_entry_A and thresh_entry_logic_A == "OR") or
                   (thresh_signal_entry_B and thresh_entry_logic_B == "OR") or
                   (thresh_signal_entry_C and thresh_entry_logic_C == "OR") or
                   (thresh_signal_entry_D and thresh_entry_logic_D == "OR") or
                   (thresh_signal_entry_E and thresh_entry_logic_E == "OR") or
                   (ext_signal_entry_A and ext_entry_logic_A == "OR") or
                   (ext_signal_entry_B and ext_entry_logic_B == "OR") or
                   (ext_signal_entry_C and ext_entry_logic_C == "OR") or
                   (ext_signal_entry_D and ext_entry_logic_D == "OR")

entry_signal = entry_andA_trigger or entry_andB_trigger or entry_or_trigger

// ============================================================================
// EXIT LOGIC GROUPS
// ============================================================================
exit_andA_count = (thresh_exit_A and thresh_exit_logic_A == "AND-A" ? 1 : 0) +
                  (thresh_exit_B and thresh_exit_logic_B == "AND-A" ? 1 : 0) +
                  (thresh_exit_C and thresh_exit_logic_C == "AND-A" ? 1 : 0) +
                  (thresh_exit_D and thresh_exit_logic_D == "AND-A" ? 1 : 0) +
                  (thresh_exit_E and thresh_exit_logic_E == "AND-A" ? 1 : 0) +
                  (ext_exit_A and ext_exit_logic_A == "AND-A" ? 1 : 0) +
                  (ext_exit_B and ext_exit_logic_B == "AND-A" ? 1 : 0) +
                  (ext_exit_C and ext_exit_logic_C == "AND-A" ? 1 : 0) +
                  (ext_exit_D and ext_exit_logic_D == "AND-A" ? 1 : 0)

exit_andB_count = (thresh_exit_A and thresh_exit_logic_A == "AND-B" ? 1 : 0) +
                  (thresh_exit_B and thresh_exit_logic_B == "AND-B" ? 1 : 0) +
                  (thresh_exit_C and thresh_exit_logic_C == "AND-B" ? 1 : 0) +
                  (thresh_exit_D and thresh_exit_logic_D == "AND-B" ? 1 : 0) +
                  (thresh_exit_E and thresh_exit_logic_E == "AND-B" ? 1 : 0) +
                  (ext_exit_A and ext_exit_logic_A == "AND-B" ? 1 : 0) +
                  (ext_exit_B and ext_exit_logic_B == "AND-B" ? 1 : 0) +
                  (ext_exit_C and ext_exit_logic_C == "AND-B" ? 1 : 0) +
                  (ext_exit_D and ext_exit_logic_D == "AND-B" ? 1 : 0)

exit_andA_true = (thresh_signal_exit_A and thresh_exit_logic_A == "AND-A" ? 1 : 0) +
                 (thresh_signal_exit_B and thresh_exit_logic_B == "AND-A" ? 1 : 0) +
                 (thresh_signal_exit_C and thresh_exit_logic_C == "AND-A" ? 1 : 0) +
                 (thresh_signal_exit_D and thresh_exit_logic_D == "AND-A" ? 1 : 0) +
                 (thresh_signal_exit_E and thresh_exit_logic_E == "AND-A" ? 1 : 0) +
                 (ext_signal_exit_A and ext_exit_logic_A == "AND-A" ? 1 : 0) +
                 (ext_signal_exit_B and ext_exit_logic_B == "AND-A" ? 1 : 0) +
                 (ext_signal_exit_C and ext_exit_logic_C == "AND-A" ? 1 : 0) +
                 (ext_signal_exit_D and ext_exit_logic_D == "AND-A" ? 1 : 0)

exit_andB_true = (thresh_signal_exit_A and thresh_exit_logic_A == "AND-B" ? 1 : 0) +
                 (thresh_signal_exit_B and thresh_exit_logic_B == "AND-B" ? 1 : 0) +
                 (thresh_signal_exit_C and thresh_exit_logic_C == "AND-B" ? 1 : 0) +
                 (thresh_signal_exit_D and thresh_exit_logic_D == "AND-B" ? 1 : 0) +
                 (thresh_signal_exit_E and thresh_exit_logic_E == "AND-B" ? 1 : 0) +
                 (ext_signal_exit_A and ext_exit_logic_A == "AND-B" ? 1 : 0) +
                 (ext_signal_exit_B and ext_exit_logic_B == "AND-B" ? 1 : 0) +
                 (ext_signal_exit_C and ext_exit_logic_C == "AND-B" ? 1 : 0) +
                 (ext_signal_exit_D and ext_exit_logic_D == "AND-B" ? 1 : 0)

exit_andA_trigger = exit_andA_count > 0 and exit_andA_true == exit_andA_count
exit_andB_trigger = exit_andB_count > 0 and exit_andB_true == exit_andB_count

exit_or_trigger = (thresh_signal_exit_A and thresh_exit_logic_A == "OR") or
                  (thresh_signal_exit_B and thresh_exit_logic_B == "OR") or
                  (thresh_signal_exit_C and thresh_exit_logic_C == "OR") or
                  (thresh_signal_exit_D and thresh_exit_logic_D == "OR") or
                  (thresh_signal_exit_E and thresh_exit_logic_E == "OR") or
                  (ext_signal_exit_A and ext_exit_logic_A == "OR") or
                  (ext_signal_exit_B and ext_exit_logic_B == "OR") or
                  (ext_signal_exit_C and ext_exit_logic_C == "OR") or
                  (ext_signal_exit_D and ext_exit_logic_D == "OR")

exit_signal = exit_andA_trigger or exit_andB_trigger or exit_or_trigger

// ============================================================================
// ENTRY COOLDOWN
// ============================================================================
var int lastExitBar = na
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index

cooldownOk = na(lastExitBar) or (bar_index - lastExitBar) >= entryCooldownBars

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================
is_long = stratDirection == "Long"
is_short = stratDirection == "Short"

atrVal = ta.atr(14)

if entry_signal and cooldownOk and is_long
    strategy.entry("Long", strategy.long)

if entry_signal and cooldownOk and is_short
    strategy.entry("Short", strategy.short)

// ============================================================================
// RISK MANAGEMENT - SL / TP / TRAILING / BREAKEVEN
// ============================================================================
var float longStopPrice = na
var float shortStopPrice = na
var bool longTrailingActive = false
var bool shortTrailingActive = false
var float longTrailHighest = na
var float shortTrailLowest = na
var bool longBEActive = false
var bool shortBEActive = false

if strategy.position_size > 0
    float slDist = slType == "ATR" ? atrVal * slATRMult : slType == "Fixed %" ? strategy.position_avg_price * slPercent / 100 : strategy.position_avg_price - ta.lowest(low, slSwingLen)
    float tpDist = tpType == "ATR Multiple" ? atrVal * tpATRMult : tpType == "Fixed %" ? strategy.position_avg_price * tpPercent / 100 : slDist * tpRRRatio

    float initialSL = strategy.position_avg_price - slDist
    float initialTP = strategy.position_avg_price + tpDist

    longTrailHighest := math.max(nz(longTrailHighest, high), high)

    if useBreakeven and not longBEActive and close - strategy.position_avg_price >= atrVal * beActivationMult
        longBEActive := true

    float effectiveSL = longBEActive ? math.max(initialSL, strategy.position_avg_price + atrVal * beOffsetMult) : initialSL

    if useTrailingStop
        if close - strategy.position_avg_price >= atrVal * trailActivationMult
            longTrailingActive := true
        if longTrailingActive
            effectiveSL := math.max(effectiveSL, longTrailHighest - atrVal * trailOffsetMult)

    longStopPrice := effectiveSL

    if useStopLoss and useTakeProfit
        strategy.exit("Long Exit", "Long", stop = effectiveSL, limit = initialTP)
    else if useStopLoss
        strategy.exit("Long SL", "Long", stop = effectiveSL)
    else if useTakeProfit
        strategy.exit("Long TP", "Long", limit = initialTP)

if strategy.position_size < 0
    float slDist = slType == "ATR" ? atrVal * slATRMult : slType == "Fixed %" ? strategy.position_avg_price * slPercent / 100 : ta.highest(high, slSwingLen) - strategy.position_avg_price
    float tpDist = tpType == "ATR Multiple" ? atrVal * tpATRMult : tpType == "Fixed %" ? strategy.position_avg_price * tpPercent / 100 : slDist * tpRRRatio

    float initialSL = strategy.position_avg_price + slDist
    float initialTP = strategy.position_avg_price - tpDist

    shortTrailLowest := math.min(nz(shortTrailLowest, low), low)

    if useBreakeven and not shortBEActive and strategy.position_avg_price - close >= atrVal * beActivationMult
        shortBEActive := true

    float effectiveSL = shortBEActive ? math.min(initialSL, strategy.position_avg_price - atrVal * beOffsetMult) : initialSL

    if useTrailingStop
        if strategy.position_avg_price - close >= atrVal * trailActivationMult
            shortTrailingActive := true
        if shortTrailingActive
            effectiveSL := math.min(effectiveSL, shortTrailLowest + atrVal * trailOffsetMult)

    shortStopPrice := effectiveSL

    if useStopLoss and useTakeProfit
        strategy.exit("Short Exit", "Short", stop = effectiveSL, limit = initialTP)
    else if useStopLoss
        strategy.exit("Short SL", "Short", stop = effectiveSL)
    else if useTakeProfit
        strategy.exit("Short TP", "Short", limit = initialTP)

// ============================================================================
// ENTRY/EXIT MARKERS
// ============================================================================
plotshape(entry_signal and is_long, title = "Long Entry", location = location.belowbar, color = color.green, style = shape.triangleup, size = size.small)
plotshape(entry_signal and is_short, title = "Short Entry", location = location.abovebar, color = color.red, style = shape.triangledown, size = size.small)
plotshape(exit_signal and is_long and strategy.position_size > 0, title = "Long Exit", location = location.abovebar, color = color.orange, style = shape.xcross, size = size.tiny)
plotshape(exit_signal and is_short and strategy.position_size < 0, title = "Short Exit", location = location.belowbar, color = color.blue, style = shape.xcross, size = size.tiny)
