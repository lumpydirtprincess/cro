thresh_profit_filter_B = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ THRESHOLD B ═══")
thresh_entry_B = input.bool(true, "Entry", inline = 'threshB_act', group = "═══ THRESHOLD B ═══")
thresh_exit_B = input.bool(false, "Exit", inline = 'threshB_act', group = "═══ THRESHOLD B ═══")
thresh_entry_logic_B = input.string("AND-A", "Entry Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD B ═══")
thresh_exit_logic_B = input.string("OR", "Exit Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD B ═══")

