thresh_hist_bar_E = input.int(0, "Hist Bar Idx", minval = 0, group = "═══ THRESHOLD E ═══")
thresh_bars_valid_E = input.int(0, "Bars Valid", minval = 0, group = "═══ THRESHOLD E ═══")
thresh_profit_filter_E = input.string("ANY", "Profit Filter", options = ["ANY", "PROFIT", "LOSS"], group = "═══ THRESHOLD E ═══")
thresh_entry_E = input.bool(true, "Entry", inline = 'threshE_act', group = "═══ THRESHOLD E ═══")
thresh_exit_E = input.bool(false, "Exit", inline = 'threshE_act', group = "═══ THRESHOLD E ═══")
thresh_entry_logic_E = input.string("AND-A", "Entry Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD E ═══")
thresh_exit_logic_E = input.string("OR", "Exit Group", options = ["AND-A", "AND-B", "OR"], group = "═══ THRESHOLD E ═══")

// ============================================================================
