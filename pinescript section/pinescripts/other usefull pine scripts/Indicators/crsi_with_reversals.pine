//@version=6
// 
// Copyright (C) 2017 CC BY, whentotrade / Lars von Thienen
// Modified to add Reverse Engineering Price Levels
// Source:
// Book: Decoding The Hidden Market Rhythm - Part 1: Dynamic Cycles (2017)
// Chapter 4: "Fine-tuning technical indicators for more details on the cRSI Indicator
// 
// Usage: 
// You need to derive the dominant cycle as input parameter for the cycle length as described in chapter 4.
//
// License: 
// This work is licensed under a Creative Commons Attribution 4.0 International License.
//
indicator(title = 'RSI cyclic smoothed with Reversal Levels', shorttitle = 'cRSI + Reversals', overlay=true, precision=2)

// ============================================================================
// INPUTS
// ============================================================================
src = input.source(close, "Source", group="cRSI Settings")
domcycle = input.int(20, minval = 10, title = 'Dominant Cycle Length', group="cRSI Settings")
vibration = input.int(10, minval = 1, title = 'Vibration', group="cRSI Settings")
leveling = input.float(10.0, minval = 0, maxval = 100, title = 'Leveling', group="cRSI Settings")

// Reversal level inputs
show_reversals = input.bool(true, "Show Reversal Price Levels", group="Reversal Settings")
show_level_100 = input.bool(true, "Show +100 Level", group="Reversal Settings", inline="pos")
show_level_250 = input.bool(false, "Show +250 Level", group="Reversal Settings", inline="pos")
show_level_neg100 = input.bool(true, "Show -100 Level", group="Reversal Settings", inline="neg")
show_level_neg250 = input.bool(false, "Show -250 Level", group="Reversal Settings", inline="neg")
show_level_zero = input.bool(true, "Show 0 Line", group="Reversal Settings")
show_upper_band = input.bool(true, "Show Upper Band", group="Reversal Settings", inline="bands")
show_lower_band = input.bool(true, "Show Lower Band", group="Reversal Settings", inline="bands")

// Colors
col_100 = input.color(color.new(color.red, 0), "+100", group="Reversal Colors", inline="c1")
col_250 = input.color(color.new(color.maroon, 0), "+250", group="Reversal Colors", inline="c1")
col_neg100 = input.color(color.new(color.lime, 0), "-100", group="Reversal Colors", inline="c2")
col_neg250 = input.color(color.new(color.green, 0), "-250", group="Reversal Colors", inline="c2")
col_zero = input.color(color.new(color.gray, 0), "Zero", group="Reversal Colors", inline="c3")
col_upper = input.color(color.new(color.orange, 30), "Upper Band", group="Reversal Colors", inline="c4")
col_lower = input.color(color.new(color.blue, 30), "Lower Band", group="Reversal Colors", inline="c4")

// ============================================================================
// cRSI CALCULATION (Original)
// ============================================================================
cyclelen = domcycle / 2
cyclicmemory = domcycle * 2

torque = 2.0 / (vibration + 1)
phasingLag = (vibration - 1) / 2.0

// Standard RSI calculation
up = ta.rma(math.max(ta.change(src), 0), cyclelen)
down = ta.rma(-math.min(ta.change(src), 0), cyclelen)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - 100 / (1 + up / down)

// Cyclic smoothing
crsi = 0.0
crsi := torque * (2 * rsi - rsi[phasingLag]) + (1 - torque) * nz(crsi[1])

// Dynamic bands calculation
lmax = -999999.0
lmin = 999999.0
for i = 0 to cyclicmemory - 1 by 1
    if nz(crsi[i], -999999.0) > lmax
        lmax := nz(crsi[i])
    if nz(crsi[i], 999999.0) < lmin
        lmin := nz(crsi[i])

mstep = (lmax - lmin) / 100
aperc = leveling / 100

// Lower band
db = lmin
for steps = 0 to 100 by 1
    testvalue = lmin + mstep * steps
    below = 0
    for m = 0 to cyclicmemory - 1 by 1
        below := below + (nz(crsi[m], 0) < testvalue ? 1 : 0)
    ratio = below / cyclicmemory
    if ratio >= aperc
        db := testvalue
        break

// Upper band
ub = lmax
for steps = 0 to 100 by 1
    testvalue = lmax - mstep * steps
    above = 0
    for m = 0 to cyclicmemory - 1 by 1
        above := above + (nz(crsi[m], 0) >= testvalue ? 1 : 0)
    ratio = above / cyclicmemory
    if ratio >= aperc
        ub := testvalue
        break

// ============================================================================
// REVERSE ENGINEERING FUNCTIONS
// ============================================================================

// Function to calculate price needed for RSI to reach a target value
// This reverses the RSI calculation: given target RSI, find required price
f_reverse_rsi(float target_rsi, float prev_up, float prev_down, int length, float prev_src) =>
    if target_rsi <= 0 or target_rsi >= 100
        na
    else
        // RSI = 100 - 100/(1 + up/down)
        // Solving for price that gives target RSI:
        // target_rsi = 100 - 100/(1 + up/down)
        // 100/(1 + up/down) = 100 - target_rsi
        // 1 + up/down = 100/(100 - target_rsi)
        // up/down = 100/(100 - target_rsi) - 1
        float rs_target = (100 / (100 - target_rsi)) - 1
        
        // up and down are RMA of gains/losses
        // alpha = 1/length for RMA
        float alpha = 1.0 / length
        
        // up[t] = alpha * gain[t] + (1-alpha) * up[t-1]
        // down[t] = alpha * loss[t] + (1-alpha) * down[t-1]
        // We need: up[t]/down[t] = rs_target
        
        // If price goes up: gain = price - prev_price, loss = 0
        // up[t] = alpha * (price - prev_src) + (1-alpha) * prev_up
        // down[t] = (1-alpha) * prev_down
        // up[t]/down[t] = rs_target
        
        // Solving for price when going up:
        float price_up = na
        if prev_down > 0
            // (alpha * (price - prev_src) + (1-alpha) * prev_up) / ((1-alpha) * prev_down) = rs_target
            // alpha * (price - prev_src) + (1-alpha) * prev_up = rs_target * (1-alpha) * prev_down
            // alpha * price = rs_target * (1-alpha) * prev_down - (1-alpha) * prev_up + alpha * prev_src
            price_up := (rs_target * (1-alpha) * prev_down - (1-alpha) * prev_up + alpha * prev_src) / alpha
        
        // If price goes down: gain = 0, loss = prev_price - price
        // up[t] = (1-alpha) * prev_up
        // down[t] = alpha * (prev_src - price) + (1-alpha) * prev_down
        // up[t]/down[t] = rs_target
        
        // Solving for price when going down:
        float price_down = na
        if alpha > 0
            // ((1-alpha) * prev_up) / (alpha * (prev_src - price) + (1-alpha) * prev_down) = rs_target
            // (1-alpha) * prev_up = rs_target * (alpha * (prev_src - price) + (1-alpha) * prev_down)
            // (1-alpha) * prev_up = rs_target * alpha * prev_src - rs_target * alpha * price + rs_target * (1-alpha) * prev_down
            // rs_target * alpha * price = rs_target * alpha * prev_src + rs_target * (1-alpha) * prev_down - (1-alpha) * prev_up
            price_down := (rs_target * alpha * prev_src + rs_target * (1-alpha) * prev_down - (1-alpha) * prev_up) / (rs_target * alpha)
        
        // Return the price closest to current price
        float current_price = src
        if not na(price_up) and not na(price_down)
            math.abs(price_up - current_price) < math.abs(price_down - current_price) ? price_up : price_down
        else if not na(price_up)
            price_up
        else
            price_down

// Function to reverse the cyclic smoothing
// Given target cRSI, find required RSI
f_reverse_crsi_to_rsi(float target_crsi, float prev_crsi, float prev_rsi) =>
    // crsi = torque * (2 * rsi - rsi[lag]) + (1 - torque) * prev_crsi
    // Solving for current rsi (assuming rsi[lag] ≈ prev_rsi for simplicity):
    // target_crsi = torque * (2 * rsi - prev_rsi) + (1 - torque) * prev_crsi
    // target_crsi = 2 * torque * rsi - torque * prev_rsi + (1 - torque) * prev_crsi
    // 2 * torque * rsi = target_crsi + torque * prev_rsi - (1 - torque) * prev_crsi
    // rsi = (target_crsi + torque * prev_rsi - (1 - torque) * prev_crsi) / (2 * torque)
    
    float required_rsi = (target_crsi + torque * prev_rsi - (1 - torque) * prev_crsi) / (2 * torque)
    required_rsi

// Main reversal function: given target cRSI level, calculate required price
f_reverse_crsi_level(float target_level) =>
    // Step 1: Reverse cyclic smoothing to get required RSI
    float required_rsi = f_reverse_crsi_to_rsi(target_level, nz(crsi[1], 50), nz(rsi[1], 50))
    
    // Step 2: Reverse RSI to get required price
    float required_price = f_reverse_rsi(required_rsi, nz(up[1], 0), nz(down[1], 0), cyclelen, nz(src[1], src))
    
    required_price

// ============================================================================
// CALCULATE REVERSAL PRICES
// ============================================================================
float price_for_100 = show_reversals and show_level_100 ? f_reverse_crsi_level(100) : na
float price_for_250 = show_reversals and show_level_250 ? f_reverse_crsi_level(250) : na
float price_for_neg100 = show_reversals and show_level_neg100 ? f_reverse_crsi_level(-100) : na
float price_for_neg250 = show_reversals and show_level_neg250 ? f_reverse_crsi_level(-250) : na
float price_for_zero = show_reversals and show_level_zero ? f_reverse_crsi_level(0) : na
float price_for_upper_band = show_reversals and show_upper_band ? f_reverse_crsi_level(ub) : na
float price_for_lower_band = show_reversals and show_lower_band ? f_reverse_crsi_level(db) : na

// ============================================================================
// PLOTS
// ============================================================================

// Plot reversal price levels on chart
plot(price_for_100, "Price for cRSI=100", col_100, 2, plot.style_line)
plot(price_for_250, "Price for cRSI=250", col_250, 2, plot.style_line)
plot(price_for_neg100, "Price for cRSI=-100", col_neg100, 2, plot.style_line)
plot(price_for_neg250, "Price for cRSI=-250", col_neg250, 2, plot.style_line)
plot(price_for_zero, "Price for cRSI=0", col_zero, 2, plot.style_line)
plot(price_for_upper_band, "Price for Upper Band", col_upper, 3, plot.style_line)
plot(price_for_lower_band, "Price for Lower Band", col_lower, 3, plot.style_line)

// Plot current price for reference
plot(src, "Current Price", color.new(color.white, 70), 1, plot.style_circles)

// ============================================================================
// INFO PANEL
// ============================================================================
if show_reversals and barstate.islast
    var table info_table = table.new(position.top_right, 2, 9, 
         bgcolor=color.new(color.black, 10), 
         frame_color=color.gray, 
         frame_width=2, 
         border_color=color.gray, 
         border_width=1)
    
    // Header
    table.cell(info_table, 0, 0, "cRSI Level", text_color=color.white, text_size=size.normal)
    table.cell(info_table, 1, 0, "Target Price", text_color=color.white, text_size=size.normal)
    
    // Current values
    table.cell(info_table, 0, 1, "Current cRSI", text_color=color.yellow, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(crsi, '#.##'), text_color=color.yellow, text_size=size.small)
    
    // Reversal levels
    int row = 2
    if show_level_250
        table.cell(info_table, 0, row, "+250", text_color=col_250, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_250) ? str.tostring(price_for_250, '#.##') : "N/A", 
             text_color=col_250, text_size=size.small)
        row += 1
    
    if show_level_100
        table.cell(info_table, 0, row, "+100", text_color=col_100, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_100) ? str.tostring(price_for_100, '#.##') : "N/A", 
             text_color=col_100, text_size=size.small)
        row += 1
    
    if show_upper_band
        table.cell(info_table, 0, row, "Upper Band (" + str.tostring(ub, '#.#') + ")", 
             text_color=col_upper, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_upper_band) ? str.tostring(price_for_upper_band, '#.##') : "N/A", 
             text_color=col_upper, text_size=size.small)
        row += 1
    
    if show_level_zero
        table.cell(info_table, 0, row, "Zero Line", text_color=col_zero, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_zero) ? str.tostring(price_for_zero, '#.##') : "N/A", 
             text_color=col_zero, text_size=size.small)
        row += 1
    
    if show_lower_band
        table.cell(info_table, 0, row, "Lower Band (" + str.tostring(db, '#.#') + ")", 
             text_color=col_lower, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_lower_band) ? str.tostring(price_for_lower_band, '#.##') : "N/A", 
             text_color=col_lower, text_size=size.small)
        row += 1
    
    if show_level_neg100
        table.cell(info_table, 0, row, "-100", text_color=col_neg100, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_neg100) ? str.tostring(price_for_neg100, '#.##') : "N/A", 
             text_color=col_neg100, text_size=size.small)
        row += 1
    
    if show_level_neg250
        table.cell(info_table, 0, row, "-250", text_color=col_neg250, text_size=size.small)
        table.cell(info_table, 1, row, not na(price_for_neg250) ? str.tostring(price_for_neg250, '#.##') : "N/A", 
             text_color=col_neg250, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(ta.cross(src, price_for_100), "cRSI 100 Cross", "Price crossed cRSI=100 level")
alertcondition(ta.cross(src, price_for_zero), "cRSI Zero Cross", "Price crossed cRSI=0 level")
alertcondition(ta.cross(src, price_for_neg100), "cRSI -100 Cross", "Price crossed cRSI=-100 level")
alertcondition(ta.cross(src, price_for_upper_band), "Upper Band Cross", "Price crossed cRSI upper band level")
alertcondition(ta.cross(src, price_for_lower_band), "Lower Band Cross", "Price crossed cRSI lower band level")
