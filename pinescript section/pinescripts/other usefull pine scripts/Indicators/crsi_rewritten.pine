// Source: Decoding The Hidden Market Rhythm - Part 1: Dynamic Cycles (2017)
//@version=6
indicator("Cyclic RSI (cRSI)", "cRSI", overlay=false)

//@function Calculates Cyclic RSI with explicit streaming logic and no warm-up dependencies
//@param src Source series to calculate cRSI for
//@param cyclelen Half of dominant cycle length for RSI calculation
//@param vibration Smoothing parameter for cyclic adjustment
//@param leveling Percentile threshold for dynamic bands (0-100)
//@param cyclicmemory Lookback period for band calculation (typically 2x dominant cycle)
//@returns Tuple of [crsi_value, lower_band, upper_band]
crsi(series float src, simple int cyclelen, simple int vibration, simple float leveling, simple int cyclicmemory) =>
    if cyclelen <= 0 or vibration <= 0 or cyclicmemory <= 0
        runtime.error("All length parameters must be greater than 0")
    if leveling < 0 or leveling > 100
        runtime.error("Leveling must be between 0 and 100")
    
    // RSI calculation using Wilder's smoothing (explicit, no ta.rma)
    float change = src - src[1]
    float u = math.max(change, 0)
    float d = math.max(-change, 0)
    float alpha = 1.0 / cyclelen
    
    var float smoothUp = 0.0
    var float smoothDown = 0.0
    
    if bar_index < cyclelen
        smoothUp := u
        smoothDown := d
    else
        smoothUp := nz(smoothUp[1]) * (1 - alpha) + u * alpha
        smoothDown := nz(smoothDown[1]) * (1 - alpha) + d * alpha
    
    float rs = smoothDown == 0 ? 0 : smoothUp / smoothDown
    float rsi = smoothDown == 0 ? 100 : 100 - (100 / (1 + rs))
    
    // Cyclic smoothing with phasing adjustment
    float torque = 2.0 / (vibration + 1)
    float phasingLag = (vibration - 1) / 2.0
    int lagBars = int(phasingLag)
    
    var float crsi_val = 50.0
    float rsi_lagged = bar_index >= lagBars ? rsi[lagBars] : rsi
    crsi_val := torque * (2 * rsi - rsi_lagged) + (1 - torque) * nz(crsi_val[1], rsi)
    
    // Dynamic band calculation using circular buffer
    var array<float> buffer = array.new_float(cyclicmemory, na)
    var int head = 0
    
    // Store current crsi value in circular buffer
    array.set(buffer, head, crsi_val)
    head := (head + 1) % cyclicmemory
    
    // Find min and max from buffer
    float lmax = -999999.0
    float lmin = 999999.0
    int valid_count = 0
    
    for i = 0 to cyclicmemory - 1
        float val = array.get(buffer, i)
        if not na(val)
            lmax := math.max(lmax, val)
            lmin := math.min(lmin, val)
            valid_count += 1
    
    // Calculate dynamic bands using percentile approach
    float db = lmin
    float ub = lmax
    
    if valid_count > 0 and lmax > lmin
        float mstep = (lmax - lmin) / 100.0
        float aperc = leveling / 100.0
        
        // Calculate lower band (percentile from bottom)
        for steps = 0 to 100
            float testvalue = lmin + mstep * steps
            int below = 0
            for m = 0 to cyclicmemory - 1
                float val = array.get(buffer, m)
                if not na(val) and val < testvalue
                    below += 1
            float ratio = below / valid_count
            if ratio >= aperc
                db := testvalue
                break
        
        // Calculate upper band (percentile from top)
        for steps = 0 to 100
            float testvalue = lmax - mstep * steps
            int above = 0
            for m = 0 to cyclicmemory - 1
                float val = array.get(buffer, m)
                if not na(val) and val >= testvalue
                    above += 1
            float ratio = above / valid_count
            if ratio >= aperc
                ub := testvalue
                break
    
    [crsi_val, db, ub]

// ---------- Main loop ----------

// Inputs
i_domcycle = input.int(20, "Dominant Cycle Length", minval=10)
i_source = input.source(close, "Source")
i_vibration = input.int(10, "Vibration (Smoothing)", minval=1)
i_leveling = input.float(10.0, "Leveling (Percentile %)", minval=0, maxval=100)

// Derived parameters
cyclelen = i_domcycle / 2
cyclicmemory = i_domcycle * 2

// Calculation
[crsi_value, lower_band, upper_band] = crsi(i_source, cyclelen, i_vibration, i_leveling, cyclicmemory)

// Reference lines
h1 = hline(30, "Lower Reference", color=color.new(color.silver, 0), linestyle=hline.style_dashed)
h2 = hline(70, "Upper Reference", color=color.new(color.silver, 0), linestyle=hline.style_dashed)

// Plot bands
blowband = plot(lower_band, "Lower Band Border", color=color.new(color.black, 0), linewidth=3)
lowband = plot(lower_band, "Lower Band", color=color.new(color.aqua, 0), linewidth=1)
bhighband = plot(upper_band, "Upper Band Border", color=color.new(color.black, 0), linewidth=3)
highband = plot(upper_band, "Upper Band", color=color.new(color.aqua, 0), linewidth=1)

// Fill areas
fill(h1, h2, color=color.new(color.silver, 90), title="Reference Zone")
fill(lowband, highband, color=color.new(color.gray, 90), title="Dynamic Band Zone")

// Plot cRSI
bcrsi = plot(crsi_value, "cRSI Border", color=color.new(color.black, 0), linewidth=3)
plot(crsi_value, "cRSI", color=color.new(color.fuchsia, 0), linewidth=2)
