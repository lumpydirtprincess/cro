vior#Error Recovery Pattern#{1}":[380,383],"#ERROR RECOVERY PATTERN:":[384,470],"#ERROR RECOVERY PATTERN:#Automatic Screenshot on Failure":[386,398],"#ERROR RECOVERY PATTERN:#Automatic Screenshot on Failure#{1}":[387,398],"#ERROR RECOVERY PATTERN:#Try-Catch with Debug Info":[399,430],"#ERROR RECOVERY PATTERN:#Try-Catch with Debug Info#{1}":[400,430],"#ERROR RECOVERY PATTERN:#Retry with Exponential Backoff":[431,470],"#ERROR RECOVERY PATTERN:#Retry with Exponential Backoff#{1}":[432,464],"#ERROR RECOVERY PATTERN:#Retry with Exponential Backoff#Parallel Execution Pattern":[465,470],"#ERROR RECOVERY PATTERN:#Retry with Exponential Backoff#Parallel Execution Pattern#{1}":[467,470],"#PARALLEL EXECUTION:":[471,543],"#PARALLEL EXECUTION:#Playwright Test Parallelization":[473,487],"#PARALLEL EXECUTION:#Playwright Test Parallelization#{1}":[474,487],"#PARALLEL EXECUTION:#Browser Contexts for Parallel Scraping":[488,514],"#PARALLEL EXECUTION:#Browser Contexts for Parallel Scraping#{1}":[489,514],"#PARALLEL EXECUTION:#Rate-Limited Parallel Processing":[515,543],"#PARALLEL EXECUTION:#Rate-Limited Parallel Processing#{1}":[516,537],"#PARALLEL EXECUTION:#Rate-Limited Parallel Processing#Network Interception Pattern":[538,543],"#PARALLEL EXECUTION:#Rate-Limited Parallel Processing#Network Interception Pattern#{1}":[540,543],"#NETWORK INTERCEPTION:":[544,621],"#NETWORK INTERCEPTION:#Block Unnecessary Resources":[546,566],"#NETWORK INTERCEPTION:#Block Unnecessary Resources#{1}":[547,566],"#NETWORK INTERCEPTION:#Mock API Responses (Testing)":[567,582],"#NETWORK INTERCEPTION:#Mock API Responses (Testing)#{1}":[568,582],"#NETWORK INTERCEPTION:#Capture API Responses":[583,601],"#NETWORK INTERCEPTION:#Capture API Responses#{1}":[584,601],"#NETWORK INTERCEPTION:#Sharp Edges":[602,621],"#NETWORK INTERCEPTION:#Sharp Edges#Using waitForTimeout Instead of Proper Waits":[604,621],"#NETWORK INTERCEPTION:#Sharp Edges#Using waitForTimeout Instead of Proper Waits#{1}":[606,621],"#REMOVE all waitForTimeout calls":[622,623],"#WRONG:":[624,628],"#WRONG:#{1}":[625,628],"#CORRECT - Auto-wait handles it:":[629,632],"#CORRECT - Auto-wait handles it:#{1}":[630,632],"#If you need to wait for specific condition:":[633,637],"#If you need to wait for specific condition:#{1}":[634,637],"#For animations, wait for element to be stable:":[638,640],"#For animations, wait for element to be stable:#{1}":[639,640],"#NEVER use setTimeout or waitForTimeout in production code":[641,659],"#NEVER use setTimeout or waitForTimeout in production code##CSS Selectors Tied to Styling Classes":[643,659],"#NEVER use setTimeout or waitForTimeout in production code##CSS Selectors Tied to Styling Classes#{1}":[645,659],"#Use user-facing locators instead:":[660,661],"#WRONG - Tied to CSS:":[662,665],"#WRONG - Tied to CSS:#{1}":[663,665],"#CORRECT - User-facing:":[666,669],"#CORRECT - User-facing:#{1}":[667,669],"#If you must use CSS, use data-testid:":[670,674],"#If you must use CSS, use data-testid:#{1}":[671,674],"#Locator priority:":[675,675],"#1. getByRole - matches accessibility":[676,676],"#2. getByText - matches visible content":[677,677],"#3. getByLabel - matches form labels":[678,678],"#4. getByTestId - explicit test contract":[679,679],"#5. CSS/XPath - last resort only":[680,698],"#5. CSS/XPath - last resort only##navigator.webdriver Exposes Automation":[682,698],"#5. CSS/XPath - last resort only##navigator.webdriver Exposes Automation#{1}":[684,698],"#Use stealth plugins:":[699,724],"#Use stealth plugins:#Puppeteer Stealth (best option):":[701,711],"#Use stealth plugins:#Puppeteer Stealth (best option):#{1}":[702,711],"#Use stealth plugins:#Playwright Stealth:":[712,717],"#Use stealth plugins:#Playwright Stealth:#{1}":[713,717],"#Use stealth plugins:#Manual (partial):":[718,724],"#Use stealth plugins:#Manual (partial):#{1}":[719,724],"#Note: This is cat-and-mouse. Detection evolves.":[725,725],"#For serious scraping, consider managed solutions like Browserbase.":[726,745],"#For serious scraping, consider managed solutions like Browserbase.##Tests Share State and Affect Each Other":[728,745],"#For serious scraping, consider managed solutions like Browserbase.##Tests Share State and Affect Each Other#{1}":[730,745],"#Each test must be fully isolated:":[746,771],"#Each test must be fully isolated:#Playwright Test (automatic isolation):":[748,756],"#Each test must be fully isolated:#Playwright Test (automatic isolation):#{1}":[749,756],"#Each test must be fully isolated:#Manual isolation:":[757,762],"#Each test must be fully isolated:#Manual isolation:#{1}":[758,762],"#Each test must be fully isolated:#Shared authentication (the right way):":[763,771],"#Each test must be fully isolated:#Shared authentication (the right way):#{1}":[764,771],"#Never modify global state in tests":[772,772],"#Never rely on previous test's actions":[773,792],"#Never rely on previous test's actions##No Trace Capture for CI Failures":[775,792],"#Never rely on previous test's actions##No Trace Capture for CI Failures#{1}":[777,792],"#Enable traces for failures:":[793,808],"#Enable traces for failures:#playwright.config.ts:":[795,804],"#Enable traces for failures:#playwright.config.ts:#{1}":[796,804],"#Enable traces for failures:#View trace locally:":[805,807],"#Enable traces for failures:#View trace locally:#{1}":[806,807],"#Enable traces for failures:#In CI, upload test-results as artifact:":[808,808],"#GitHub Actions:":[809,815],"#GitHub Actions:#{1}":[810,815],"#Trace shows:":[816,816],"#- Timeline of actions":[817,817],"#- Screenshots at each step":[818,818],"#- Network requests and responses":[819,819],"#- Console logs":[820,820],"#- DOM snapshots":[821,839],"#- DOM snapshots##Tests Pass Headed but Fail Headless":[823,839],"#- DOM snapshots##Tests Pass Headed but Fail Headless#{1}":[825,839],"#Set consistent viewport:":[840,848],"#Set consistent viewport:#{1}":[841,848],"#Or in config:":[849,855],"#Or in config:#{1}":[850,855],"#Debug headless failures:":[856,856],"#1