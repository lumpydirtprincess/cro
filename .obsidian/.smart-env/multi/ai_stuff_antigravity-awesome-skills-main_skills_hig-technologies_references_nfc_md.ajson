ome screen on iPhone, which offers an opportunity to open a specific app to process NFC tag data detected nearby.","target":"https://docs-assets.developer.apple.com/published/f42e796e585f504e450d1bf030a66d69/nfc-background%402x.png","line":38,"embedded":true},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/nfc#Platform-considerations","line":42},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/nfc#Resources","line":46},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/nfc#Developer-documentation","line":48},{"title":"Core NFC","target":"https://developer.apple.com/documentation/CoreNFC","line":50}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ai stuff/antigravity-awesome-skills-main/skills/hig-technologies/references/nfc.md"},
