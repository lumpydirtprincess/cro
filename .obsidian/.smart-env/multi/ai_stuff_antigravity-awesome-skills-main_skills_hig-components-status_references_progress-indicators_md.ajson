.apple.com/published/6c1e23fcc6e04603423dacd5df6c48a3/progress-indicator-intermediate-spinner%402x.png","line":30,"embedded":true},{"title":"An image of a spinning activity indicator in watchOS.","target":"https://docs-assets.developer.apple.com/published/02a8427a04f946d9b80d2907f84ab365/activity-indicators-watch%402x.png","line":32,"embedded":true},{"title":"`ProgressView`","target":"https://developer.apple.com/documentation/SwiftUI/ProgressView","line":34},{"title":"Best practices","target":"https://developer.apple.com/design/human-interface-guidelines/progress-indicators#Best-practices","line":36},{"title":"alert","target":"https://developer.apple.com/design/human-interface-guidelines/alerts","line":54},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/progress-indicators#Platform-considerations","line":56},{"title":"iOS, iPadOS","target":"https://developer.apple.com/design/human-interface-guidelines/progress-indicators#iOS-iPadOS","line":60},{"title":"Refresh content controls","target":"https://developer.apple.com/design/human-interface-guidelines/progress-indicators#Refresh-content-controls","line":62},{"title":"A screenshot of a refresh content control spinning while Mail checks for new messages.","target":"https://docs-assets.developer.apple.com/published/861acc5c0d9d6821e3dd4fd7fb42606f/refresh-controls%402x.png","line":66,"embedded":true},{"title":"`UIRefreshControl`","target":"https://developer.apple.com/documentation/UIKit/UIRefreshControl","line":72},{"title":"macOS","target":"https://developer.apple.com/design/human-interface-guidelines/progress-indicators#macOS","line":74},{"title":"An image of a completely filled horizontal progress bar in macOS. The fill is animated to cycle through various shade changes as progress continues.","target":"https://docs-assets.developer.apple.com/published/53c298b42043574cfe1d304c01bfc967/progress-indicator-intermediate-bar%402x.png","line":78,"embedded":true},{"t