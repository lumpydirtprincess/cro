83,-0.05169054,-0.02845971,-0.00833788,-0.09540316,-0.0099392,0.06794768,-0.04577264,0.01126541,-0.00486196,0.1199662,-0.0349567,-0.03389544,-0.10436351,0.00482021,-0.0094629,0.19308357,-0.08032078,-0.02796257,-0.00302074,-0.01482011,-0.01609728,0.05165493,0.01057457,0.04863698,-0.01685241,0.03827833,0.04717558,0.05041156,0.0504707,-0.04147959,-0.05592666,0.00259715,0.00415741,0.00244691,-0.02134116,-0.05061939,0.01964675,0.07034144,-0.03277768,-0.03006718,-0.01364939,0.01336244,-0.02247043,-0.0107964,-0.04647991,-0.04188799,-0.00078558,-0.00182326,-0.00734547,0.07358626,0.01535053,0.02119632,-0.0170984,-0.05287423,0.06470355,0.03999542,0.08019307,0.06325521],"last_embed":{"tokens":432,"hash":"vtgniv"}}},"last_read":{"hash":"vtgniv","at":1780321044607},"class_name":"SmartSource","last_import":{"mtime":1779893534184,"size":13841,"at":1780317863219,"hash":"vtgniv"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of the ResearchKit icon. The image is overlaid with rectangular and circular grid lines and is tinted blue to subtly reflect the blue in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/9bd44d7f951617f42270a366911fe357/technologies-ResearchKit-intro%402x.png","line":9,"embedded":true},{"title":"Research & Care > ResearchKit","target":"https://www.researchandcare.org/researchkit/","line":11},{"title":"Creating the onboarding experience","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Creating-the-onboarding-experience","line":15},{"title":"A diagram showing four boxes in a horizontal row. Beginning with the leftmost box, an arrow pointing toward the right connects each box to the next. From the left, the boxes are labeled Introduction, Eligibility, Informed consent, and Permission to access data.","target":"https://docs-assets.developer.apple.com/published/e6a857b89c1b4b7b254861411fa0d08d/researchkit-diagram%402x.png","line":21,"embedded":true},{"title":"1\\. Introduction","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#1-Introduction","line":23},{"title":"A screenshot that shows a ResearchKit app's introductory screen on iPhone, which invites someone to join a study.","target":"https://docs-assets.developer.apple.com/published/b2e12c8eeedeb58c2b31f6da926be952/introduction-screen%402x.png","line":27,"embedded":true},{"title":"2\\. Determine eligibility","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#2-Determine-eligibility","line":29},{"title":"A screenshot that shows a ResearchKit app's eligibility screen on iPhone. The screen includes fields that ask for a person's age, location, and type of smartphone. The bottom of the screen includes 'Back' and 'Submit' buttons, and the top of the screen includes a button for returning to the previous screen and a button for help.","target":"https://docs-assets.developer.apple.com/published/c458c3b78dc70a5ec20e2fbcfdfcce32/eligibility-screen%402x.png","line":33,"embedded":true},{"title":"3\\. Get informed consent","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#3-Get-informed-consent","line":35},{"title":"A screenshot that shows a ResearchKit app's quiz screen on iPhone. The screen displays a multiple-choice question designed to make sure people understand the study. The bottom of the screen includes a 'Next' button, and the top of the screen includes a button for returning to the previous screen and a button for help.","target":"https://docs-assets.developer.apple.com/published/09184ffb5a698e998d39bb44458911a8/consent-quiz-screen%402x.png","line":43,"embedded":true},{"title":"A screenshot that shows a ResearchKit app's consent screen on iPhone. The screen recaps key points about the study, shows the person's name, and asks the person to confirm whether they'd like to participate in the study. The bottom of the screen includes 'Disagree' and 'Accept' buttons, and the top of the screen includes a button for returning to the previous screen and a button for help.","target":"https://docs-assets.developer.apple.com/published/46b3fb7e5f95abccac05269223545a05/consent-signature-screen%402x.png","line":47,"embedded":true},{"title":"4\\. Request permission to access data","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#4-Request-permission-to-access-data","line":49},{"title":"A screenshot that shows a ResearchKit app's consent screen on iPhone. The screen recaps key points about the study, and offers the choice to share data with researchers for future research purposes, or only for this particular study. The bottom of the screen includes an 'Accept' button, and the top of the screen includes a button for returning to the previous screen and a button for help.","target":"https://docs-assets.developer.apple.com/published/bcceaf89b0a6997c37f5179229674b84/permissions-health-data-screen%402x.png","line":53,"embedded":true},{"title":"Conducting research","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Conducting-research","line":55},{"title":"A screenshot that shows a ResearchKit app's survey screen on iPhone. This particular screen asks someone to specify Parkinson's disease symptoms from a list and tap a 'Next' button to continue the survey. The top of the screen includes a 'Close' button.","target":"https://docs-assets.developer.apple.com/published/ee125d1de4ec07f41856c9bab67ee0c3/survey-question-type1-screen%402x.png","line":76,"embedded":true},{"title":"A screenshot that shows a ResearchKit app's active task screen on iPhone. This particular screen shows an illustration of a person walking, and instructions that explain how to perform a Walk and Balance active task. A list of requirements is shown, along with a 'Get started' button. The top of the screen includes a 'Close' button.","target":"https://docs-assets.developer.apple.com/published/efdeed00e3196a8eaea5155ff78b0015/active-tasks-screen%402x.png","line":89,"embedded":true},{"title":"Managing personal information and providing encouragement","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Managing-personal-information-and-providing-encouragement","line":91},{"title":"A screenshot that shows a ResearchKit app's profile screen on iPhone. This particular screen includes a list of fields for personal information like name and birth year. Each field includes a button for editing the field's value. The top of the screen includes a settings button, and the bottom of the screen includes tabs for 'Tracking', 'History' and 'Profile'. The active tab is 'Profile'.","target":"https://docs-assets.developer.apple.com/published/9112be9b40dfaec1cc5270f94adc4645/profile-screen%402x.png","line":97,"embedded":true},{"title":"A screenshot that shows a ResearchKit app's history screen on iPhone. This particular screen shows a log of active tasks performed over two days. The bottom of the screen includes tabs for 'Tracking', 'History' and 'Profile'. The active tab is 'History'.","target":"https://docs-assets.developer.apple.com/published/d5c1639ec410f2064db916c146e27f17/dashboard-screen%402x.png","line":101,"embedded":true},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Platform-considerations","line":103},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Resources","line":107},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Related","line":109},{"title":"Research & Care > ResearchKit","target":"https://www.researchandcare.org/researchkit/","line":111},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Developer-documentation","line":113},{"title":"Research & Care > Developers","target":"https://www.researchandcare.org/developers/","line":115},{"title":"Protecting user privacy","target":"https://developer.apple.com/documentation/HealthKit/protecting-user-privacy","line":117},{"title":"ResearchKit GitHub project","target":"https://github.com/ResearchKit/ResearchKit","line":119},{"title":"Videos","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Videos","line":121},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/49/196C46B0-DF68-4947-B211-4FEECE415A6E/3408_wide_250x141_1x.jpg","line":123},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/119/EAFF830B-8468-49BA-A5DC-D3A3E8B7F463/4960_wide_250x141_1x.jpg","line":125},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/48/E6EBBD96-C3E4-4A7E-908A-A692F708AE26/2633_wide_250x141_1x.jpg","line":127},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/researchkit#Change-log","line":129}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ai stuff/antigravity-awesome-skills-main/skills/hig-technologies/references/researchkit.md"},
