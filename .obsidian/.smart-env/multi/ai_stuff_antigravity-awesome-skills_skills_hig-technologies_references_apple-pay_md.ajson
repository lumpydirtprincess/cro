d/apple-pay-mark-with-payment-options%402x.png","line":377,"embedded":true},{"title":"here","target":"https://developer.apple.com/apple-pay/marketing/","line":383},{"title":"Referring to Apple Pay","target":"https://developer.apple.com/design/human-interface-guidelines/apple-pay#Referring-to-Apple-Pay","line":385},{"title":"Guidelines for Using Apple Trademarks","target":"https://www.apple.com/legal/intellectual-property/guidelinesfor3rdparties.html","line":387},{"title":"Apple Trademark List","target":"https://www.apple.com/legal/intellectual-property/trademark/appletmlist.html","line":387},{"title":"Correct usage","target":"https://docs-assets.developer.apple.com/published/88662da92338267bb64cd2275c84e484/checkmark%402x.png","line":397,"embedded":true},{"title":"Correct usage","target":"https://docs-assets.developer.apple.com/published/88662da92338267bb64cd2275c84e484/checkmark%402x.png","line":398,"embedded":true},{"title":"Incorrect usage","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":399,"embedded":true},{"title":"Incorrect usage","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":400,"embedded":true},{"title":"Incorrect usage","target":"https://docs-assets.developer.apple.com/published/209f6f0fc8ad99d9bf59e12d82d06584/crossout%402x.png","line":401,"embedded":true},{"title":"Offering Apple Pay","target":"https://developer.apple.com/design/human-interface-guidelines/apple-pay#Offering-Apple-Pay","line":407},{"title":"App Store marketing guidelines","target":"https://developer.apple.com/app-store/marketing/guidelines/","line":409},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/apple-pay#Platform-considerations","line":411},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/apple-pay#Resources","line":415},{"title":"Related",