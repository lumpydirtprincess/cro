9e12d82d06584/crossout%402x.png","line":184,"embedded":true},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/tap-to-pay-on-iphone#Platform-considerations","line":186},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/tap-to-pay-on-iphone#Resources","line":190},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/tap-to-pay-on-iphone#Related","line":192},{"title":"Tap to Pay on iPhone Marketing guidelines","target":"https://developer.apple.com/tap-to-pay/marketing-guidelines/","line":194},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/tap-to-pay-on-iphone#Developer-documentation","line":196},{"title":"Adding support for Tap to Pay on iPhone to your app","target":"https://developer.apple.com/documentation/ProximityReader/adding-support-for-tap-to-pay-on-iphone-to-your-app","line":198},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/tap-to-pay-on-iphone#Change-log","line":200}],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ai stuff/antigravity-awesome-skills-main/skills/hig-technologies/references/tap-to-pay-on-iphone.md"},
