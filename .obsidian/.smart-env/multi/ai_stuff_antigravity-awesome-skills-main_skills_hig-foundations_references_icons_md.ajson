ointing up from the middle of square.","target":"https://docs-assets.developer.apple.com/published/b5fa28be3d82955fc380f44783befd32/icons-symbols-meaning-sharing%402x.png","line":123,"embedded":true},{"title":"An icon showing a printer.","target":"https://docs-assets.developer.apple.com/published/9de4d23e30e6fd8331215dd6dab12878/icons-symbols-meaning-print%402x.png","line":125,"embedded":true},{"title":"Users and accounts","target":"https://developer.apple.com/design/human-interface-guidelines/icons#Users-and-accounts","line":127},{"title":"An icon showing an abstract representation of a person’s head and shoulders in a circular outline.","target":"https://docs-assets.developer.apple.com/published/512c86a1c2c99bc09991c89c1e535441/icons-symbols-meaning-account-user%402x.png","line":131,"embedded":true},{"title":"Ratings","target":"https://developer.apple.com/design/human-interface-guidelines/icons#Ratings","line":135},{"title":"An icon showing a hand giving a thumbs down gesture.","target":"https://docs-assets.developer.apple.com/published/189b97655ff655985deec03d0466b898/icons-symbols-meaning-dislike%402x.png","line":139,"embedded":true},{"title":"An icon showing a hand giving a thumbs up gesture.","target":"https://docs-assets.developer.apple.com/published/6f38eef523ffbb4f1d6de22a6a022309/icons-symbols-meaning-like%402x.png","line":140,"embedded":true},{"title":"Layer ordering","target":"https://developer.apple.com/design/human-interface-guidelines/icons#Layer-ordering","line":142},{"title":"An icon showing a stack of three squares overlapping each other, with the top square using a solid fill style while the other squares are outlines.","target":"https://docs-assets.developer.apple.com/published/c5da334738c9baf5ddaa0d6ed9de0af6/icons-symbols-meaning-bring-to-front%402x.png","line":146,"embedded":true},{"title":"An icon showing a stack of three squares overlapping each other, with the bottom square using a solid fill style while the other squares are outlines.","ta