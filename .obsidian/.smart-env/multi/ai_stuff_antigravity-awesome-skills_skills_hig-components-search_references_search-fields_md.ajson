
"smart_sources:ai stuff/antigravity-awesome-skills/skills/hig-components-search/references/search-fields.md": {"path":"ai stuff/antigravity-awesome-skills/skills/hig-components-search/references/search-fields.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"qvdphf","at":1779618283744},"class_name":"SmartSource","last_import":{"mtime":1777961475208,"size":19890,"at":1779618283745,"hash":"qvdphf"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A stylized representation of a search field containing placeholder text and a dictation icon. The image is tinted red to subtly reflect the red in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/73f9e564b79cbe48e29ae2a9f7b83682/components-search-field-intro%402x.png","line":9,"embedded":true},{"title":"scope control","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Scope-controls-and-tokens","line":11},{"title":"tokens","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Scope-controls-and-tokens","line":11},{"title":"Searching","target":"https://developer.apple.com/design/human-interface-guidelines/searching","line":13},{"title":"Adding a search interface to your app","target":"https://developer.apple.com/documentation/SwiftUI/Adding-a-search-interface-to-your-app","line":13},{"title":"Best practices","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Best-practices","line":15},{"title":"Scope controls and tokens","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Scope-controls-and-tokens","line":27},{"title":"segmented control","target":"https://developer.apple.com/design/human-interface-guidelines/segmented-controls","line":31},{"title":"A diagram of the Mail app on iPhone with the search field open above the keyboard and the word Design entered in the field. Callouts indicate a scope control at the top of the screen to switch between searching all mailboxes and the current mailbox, and a list of tokens in a Suggestions area beneath the control that represent different filters for the search.","target":"https://docs-assets.developer.apple.com/published/c39602d60041fae736e46f91641d8373/search-fields-scope-control-tokens%402x.png","line":38,"embedded":true},{"title":"Scoping a search operation","target":"https://developer.apple.com/documentation/SwiftUI/Scoping-a-search-operation","line":40},{"title":"Token fields","target":"https://developer.apple.com/design/human-interface-guidelines/token-fields","line":44},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Platform-considerations","line":48},{"title":"iOS","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#iOS","line":52},{"title":"Search in a tab bar","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Search-in-a-tab-bar","line":67},{"title":"An illustration of a tab bar at the bottom of an iPhone screen. A tab for search appears on the trailing edge in a visually distinct group.","target":"https://docs-assets.developer.apple.com/published/ca6977596a62743265fdd2132616a4c8/search-fields-search-as-tab%402x.png","line":71,"embedded":true},{"title":"An illustration of an iPhone screen with search in a tab bar at the bottom of the screen. The tab bar is hidden by the keyboard and the search field is open above the keyboard, ready for text entry.","target":"https://docs-assets.developer.apple.com/published/cbd1eb280ecd0f8f71aab784a2bcd042/search-fields-tab-focused%402x.png","line":75,"embedded":true},{"title":"An illustration of an iPhone screen with search in a tab bar at the bottom of the screen. The search tab is expanded into a field that hides the tabs to its leading side. A single remaining tab on the leading edge of the screen indicates that it's possible to navigate away, and the space above the tab bar is empty and available for other content.","target":"https://docs-assets.developer.apple.com/published/196b81213f5131b324f952180a4e9c46/search-fields-tab-unfocused%402x.png","line":79,"embedded":true},{"title":"Search in a toolbar","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Search-in-a-toolbar","line":87},{"title":"An illustration of an iPhone screen with search in a bottom toolbar. The search field is positioned in an isolated group between a Filter button on the leading edge and a Compose button on the trailing edge.","target":"https://docs-assets.developer.apple.com/published/face9eed2f9c99f2c12ca3a400919e03/search-fields-ios-toolbar-with-items%402x.png","line":98,"embedded":true},{"title":"An illustration of an iPhone screen with search in a top toolbar. A Back button appears on the leading edge, and an Add button appears on the trailing edge. An button group with Search and More appears next to the Add button.","target":"https://docs-assets.developer.apple.com/published/ca4d0118cd29bd05bd2fd114163a1f64/search-fields-ios-navigation-bar-item%402x.png","line":102,"embedded":true},{"title":"Search as an inline field","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Search-as-an-inline-field","line":110},{"title":"iPadOS, macOS","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#iPadOS-macOS","line":120},{"title":"An illustration of an iPad screen with a search field on the trailing edge of the top toolbar. The search field has the word Design entered into the field, and three search suggestions appear in a list beneath the field. The toolbar also includes an Inspector button, a group with New Folder and Favorite buttons, and a Share button next to the search field.","target":"https://docs-assets.developer.apple.com/published/368ba21a44b4c65a4e53d3d2197d061b/search-fields-toolbar-search-ipad%402x.png","line":124,"embedded":true},{"title":"An illustration of a Mac screen with a search field on the trailing edge of the toolbar. The search field has the word Design entered into the field, and three search suggestions appear in a list beneath the field. The toolbar also includes an Inspector button, a group with New Folder and Favorite buttons, and a Share button next to the search field.","target":"https://docs-assets.developer.apple.com/published/eb1970b09f7b35b39757201a31289bc3/search-fields-toolbar-search-mac%402x.png","line":126,"embedded":true},{"title":"An illustration of an iPad screen with a search field at the top of the sidebar on the leading edge of the screen.","target":"https://docs-assets.developer.apple.com/published/8aed61a23fe2a9885d1a1d1da15a4b09/search-fields-ipad-search-in-sidebar%402x.png","line":132,"embedded":true},{"title":"An illustration of an iPad screen with a tab bar at the top edge. The trailing side of the tab bar includes a Search tab with a distinct background color to differentiate it from other tab areas.","target":"https://docs-assets.developer.apple.com/published/a2ab9bc29018fc1bbc604a91dfc905c7/search-fields-ipad-search-in-tab-bar%402x.png","line":136,"embedded":true},{"title":"tvOS","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#tvOS","line":142},{"title":"`UISearchController`","target":"https://developer.apple.com/documentation/UIKit/UISearchController","line":144},{"title":"An illustration of a search screen in tvOS. The screen includes a field with a keyboard input area at the top, a scope control, and a grid of top results at the bottom.","target":"https://docs-assets.developer.apple.com/published/590a4ef7b02ccd9758f0e52e5c261574/search-fields-tvos-search%402x.png","line":146,"embedded":true},{"title":"Using suggested searches with a search controller","target":"https://developer.apple.com/documentation/UIKit/using-suggested-searches-with-a-search-controller","line":148},{"title":"watchOS","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#watchOS","line":150},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Resources","line":154},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Related","line":156},{"title":"Searching","target":"https://developer.apple.com/design/human-interface-guidelines/searching","line":158},{"title":"Token fields","target":"https://developer.apple.com/design/human-interface-guidelines/token-fields","line":160},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Developer-documentation","line":162},{"title":"Adding a search interface to your app","target":"https://developer.apple.com/documentation/SwiftUI/Adding-a-search-interface-to-your-app","line":164},{"title":"`searchable(text:placement:prompt:)`","target":"https://developer.apple.com/documentation/SwiftUI/View/searchable\\(text:placement:prompt:\\","line":166},{"title":"`UISearchBar`","target":"https://developer.apple.com/documentation/UIKit/UISearchBar","line":168},{"title":"`UISearchTextField`","target":"https://developer.apple.com/documentation/UIKit/UISearchTextField","line":170},{"title":"`NSSearchField`","target":"https://developer.apple.com/documentation/AppKit/NSSearchField","line":172},{"title":"Videos","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Videos","line":174},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/3055294D-836B-4513-B7B0-0BC5666246B0/1AAA030E-2ECA-47D8-AE09-6D7B72A840F6/10044_wide_250x141_1x.jpg","line":176},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/119/BE8FF113-0FE1-40FC-86BF-FE95BE2FF7A5/5027_wide_250x141_1x.jpg","line":178},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/119/D45C244B-2038-4692-99A0-6131ED5FD984/5084_wide_250x141_1x.jpg","line":180},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/search-fields#Change-log","line":182}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ai stuff/antigravity-awesome-skills/skills/hig-components-search/references/search-fields.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"0","at":1779618283744},"key":"ai stuff/antigravity-awesome-skills/skills/hig-components-search/references/search-fields.md#---frontmatter---","lines":[1,null],"size":0,"outlinks":[],"class_name":"SmartBlock"},

