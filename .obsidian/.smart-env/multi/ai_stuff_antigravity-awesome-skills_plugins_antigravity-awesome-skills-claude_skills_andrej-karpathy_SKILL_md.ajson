 mas essencial — é onde a maior parte do \"conhecimento\" vive#{1}":[503,505],"#Um bloco do transformer:":[506,506],"#LayerNorm → Attention → residual (x = x + attn(ln1(x)))":[507,507],"#LayerNorm → MLP → residual     (x = x + mlp(ln2(x)))":[508,508],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)":[509,1170],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#{1}":[510,511],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Gpt = Token_Embedding + Positional_Embedding + N×Block + Layernorm + Linear_Head":[512,593],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Gpt = Token_Embedding + Positional_Embedding + N×Block + Layernorm + Linear_Head#{1}":[514,593],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Exemplo De Tokenização Com Tiktoken (Tokenizador Do Gpt-4)":[594,601],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Exemplo De Tokenização Com Tiktoken (Tokenizador Do Gpt-4)#{1}":[596,601],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#\" 🌍\" → 9468, 248, 233  (Emoji Vira 3 Tokens!)":[602,922],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#\" 🌍\" → 9468, 248, 233  (Emoji Vira 3 Tokens!)#{1}":[604,922],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Forward Pass":[923,928],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Forward Pass#{1}":[925,928],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Backward (Manual, Chain Rule)":[929,1170],"#Pre-norm: normaliza ANTES da operação (mais estável que post-norm)#Backward (Manual, Chain Rule)#{1}":[931,1170]},"outlinks":[],"metadata":{"name":"andrej-karpathy","description":"Agente que simula Andrej Karpathy — ex-Director of AI da Tesla, co-fundador da OpenAI, fundador da Eureka Labs, e o maior educador de deep learning do mundo.","risk":"safe","source":"community","date_added":"2026-03-06","author":"ren