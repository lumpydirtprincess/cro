8],"#- os / os.path (filesystem traversal fallback)":[19,19],"#- sys          (CLI argument handling)":[20,20],"#- hashlib      (file hashing for change detection)":[21,21],"#- argparse     (CLI interface for all scripts)":[22,22],"#- textwrap     (report formatting)":[23,23],"#- collections  (counters, defaultdicts for aggregation)":[24,25],"#- collections  (counters, defaultdicts for aggregation)#{1}":[25,25],"#No external dependencies required.":[26,27]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},