s":[110,120],"#Input types for complex mutations#{1}":[111,120],"#Input types":[121,133],"#Input types#{1}":[122,133],"#Payload types (for errors as data)":[134,145],"#Payload types (for errors as data)#{1}":[135,145],"#Enums":[146,152],"#Enums#{1}":[147,152],"#Types with relationships":[153,171],"#Types with relationships#{1}":[154,171],"#Pagination (Relay-style)":[172,196],"#Pagination (Relay-style)#{1}":[173,190],"#Pagination (Relay-style)##DataLoader for N+1 Prevention":[191,196],"#Pagination (Relay-style)##DataLoader for N+1 Prevention#{1}":[193,196],"#DATALOADER:":[197,271],"#DATALOADER:#{1}":[199,265],"#DATALOADER:##Apollo Client Caching":[266,271],"#DATALOADER:##Apollo Client Caching#{1}":[268,271],"#APOLLO CLIENT CACHING:":[272,398],"#APOLLO CLIENT CACHING:#{1}":[274,392],"#APOLLO CLIENT CACHING:##Code Generation":[393,398],"#APOLLO CLIENT CACHING:##Code Generation#{1}":[395,398],"#GRAPHQL CODEGEN:":[399,405],"#GRAPHQL CODEGEN:#{1}":[401,405],"#Install":[406,411],"#Install#{1}":[407,411],"#codegen.ts":[412,434],"#codegen.ts#{1}":[413,434],"#Run generation":[435,437],"#Run generation#{1}":[436,437],"#Usage - fully typed!":[438,455],"#Usage - fully typed!#{1}":[439,449],"#Usage - fully typed!##Error Handling with Unions":[450,455],"#Usage - fully typed!##Error Handling with Unions#{1}":[452,455],"#ERRORS AS DATA:":[456,462],"#ERRORS AS DATA:#{1}":[458,462],"#Schema":[463,483],"#Schema#{1}":[464,483],"#Resolver":[484,519],"#Resolver#{1}":[485,519],"#Client query":[520,575],"#Client query#{1}":[521,553],"#Client query#Sharp Edges":[554,575],"#Client query#Sharp Edges#Each resolver makes separate database queries":[556,575],"#Client query#Sharp Edges#Each resolver makes separate database queries#{1}":[558,575],"#USE DATALOADER":[576,597],"#USE DATALOADER#{1}":[578,597],"#Key points:":[598,598],"#1. Create new loaders per request (for caching scope)":[599,599],"#2. Return results in same order as input IDs":[600,600],"#3. Handle missing items (return null, not skip)":[601,622],"#3. Handle missing items (return null, not skip)##Deeply nested queries can DoS your server":[603,622],"#3. Handle missing items (return null, not skip)##Deeply nested queries can DoS your server#{1}":[605,622],"#LIMIT QUERY DEPTH AND COMPLEXITY":[623,643],"#LIMIT QUERY DEPTH AND COMPLEXITY#{1}":[625,643],"#Also consider:":[644,644],"#- Query timeout limits":[645,645],"#- Rate limiting per client":[646,646],"#- Persisted queries (only allow pre-registered queries)":[647,668],"#- Persisted queries (only allow pre-registered queries)##Introspection enabled in production exposes your schema":[649,668],"#- Persisted queries (only allow pre-registered queries)##Introspection enabled in production exposes your schema#{1}":[651,668],"#DISABLE INTROSPECTION IN PRODUCTION":[669,681],"#DISABLE INTROSPECTION IN PRODUCTION#{1}":[671,681],"#Better: Use persisted queries":[682,682],"#Only allow pre-registered queries in production":[683,711],"#Only allow pre-registered queries in production#{1}":[684,691],"#Only allow pre-registered queries in production##Authorization only in schema directives, not resolvers":[692,711],"#Only allow pre-registered queries in production##Authorization only in schema directives, not resolvers#{1}":[694,711],"#AUTHORIZE IN RESOLVERS":[712,771],"#AUTHORIZE IN RESOLVERS#{1}":[714,751],"#AUTHORIZE IN RESOLVERS##Authorization on queries but not on fields":[752,771],"#AUTHORIZE IN RESOLVERS##Authorization on queries but not on fields#{1}":[754,771],"#FIELD-LEVEL AUTHORIZATION":[772,822],"#FIELD-LEVEL AUTHORIZATION#{1}":[774,802],"#FIELD-LEVEL AUTHORIZATION##Non-null field failure nullifies entire parent":[803,822],"#FIELD-LEVEL AUTHORIZATION##Non-null field failure nullifies entire parent#{1}":[805,822],"#DESIGN NULLABILITY INTENTIONALLY":[823,824],"#WRONG: Everything non-null":[825,833],"#WRONG: Everything non-null#{1}":[826,833],"#RIGHT: Nullable where appropriate":[834,842],"#RIGHT: Nullable where appropriate#{1}":[835,842],"#For lists:":[843,843],"#[User!]! - Non-null list of non-null users (recommended)":[844,844],"#[User!]  - Nullable list of non-null users":[845,845],"#[User]!  - Non-null list of nullable users (rarely useful)":[846,846],"#[User]   - Nullable list of nullable users (avoid)":[847,848],"#Rule of thumb:":[849,849],"#- Non-null if always present and failure should fail query":[850,850],"#- Nullable if optional or failure shouldn't break response":[851,872],"#- Nullable if optional or failure shouldn't break response##Expensive queries treated same as cheap ones":[853,872],"#- Nullable if optional or failure shouldn't break response##Expensive queries treated same as cheap ones#{1}":[855,872],"#QUERY COST ANALYSIS":[873,925],"#QUERY COST ANALYSIS#{1}":[875,905],"#QUERY COST ANALYSIS##Subscriptions not properly cleaned up":[906,925],"#QUERY COST ANALYSIS##Subscriptions not properly cleaned up#{1}":[908,925],"#PROPER SUBSCRIPTION CLEANUP":[926,1077],"#PROPER SUBSCRIPTION CLEANUP#{1}":[928,973],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks":[974,1047],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Introspection enabled in production":[976,983],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Introspection enabled in production#{1}":[978,983],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Direct database query in resolver":[984,991],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Direct database query in resolver#{1}":[986,991],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#No query depth limiting":[992,999],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#No query depth limiting#{1}":[994,999],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Resolver without try-catch":[1000,1007],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#Resolver without try-catch#{1}":[1002,1007],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#JSON or Any type in schema":[1008,1015],"#PROPER SUBSCRIPTION CLEANUP#Validation Checks#JSON or Any type in schema#{1}":[1010,1015],"#PROPER SUBSCRIPTION CLEANUP#Vali