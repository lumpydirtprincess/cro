疗信息卡生成器#格式说明#{1}":[428,430],"#紧急医疗信息卡生成器#When to Use":[431,433],"#紧急医疗信息卡生成器#When to Use#{1}":[432,433],"#紧急医疗信息卡生成器#Limitations":[434,438],"#紧急医疗信息卡生成器#Limitations#{1}":[435,438]},"outlinks":[],"metadata":{"name":"emergency-card","description":"生成紧急情况下快速访问的医疗信息摘要卡片。当用户需要旅行、就诊准备、紧急情况或询问\"紧急信息\"、\"医疗卡片\"、\"急救信息\"时使用此技能。提取关键信息（过敏、用药、急症、植入物），支持多格式输出（JSON、文本、二维码），用于急救或快速就医。","risk":"unknown","source":"community"},"task_lines":[],"tasks":{},"codeblock_ranges":[[45,59],[84,102],[107,118],[121,131],[134,185],[188,199],[203,214],[218,230],[233,238],[243,257],[266,310],[314,317],[322,331],[335,362]]},"smart_blocks:ai stuff/antigravity-awesome-skills/skills/emergency-card/SKILL.md#---frontmatter---": {"path":null,"last_embed":{"hash":"edfm3","at":1779620471796},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05126513,-0.01304337,-0.02832966,0.0392166,0.02255217,-0.00716834,0.07153446,0.0228071,-0.01940998,0.00710864,-0.03467558,-0.08644004,-0.00264261,0.04627821,0.02416294,0.04560003,0.02095806,-0.00774677,-0.05057557,-0.00405205,0.10128735,0.01383401,-0.00672582,-0.07912131,0.0253,0.04256046,-0.00963996,-0.028071,0.00742879,-0.13963537,-0.04503154,0.00786029,0.08588127,0.03058974,-0.00844277,0.00800614,-0.05598103,0.06695981,-0.07660147,0.02561236,0.03098531,-0.01488392,0.01824497,-0.02053335,0.0472694,-0.01866755,0.02183805,-0.00542392,0.02809798,-0.04696135,0.0002058,-0.0083511,0.01870815,0.01812807,0.03906717,-0.07827578,0.04939606,-0.00599558,0.03186479,0.02695227,0.03676504,0.07450811,-0.15616897,0.054933,-0.04779311,-0.03218134,-0.01812595,-0.02741875,0.07377048,0.01633604,0.00862102,0.03515049,0.0211039,0.08946721,0.02495398,0.0160802,0.02113422,-0.03207362,-0.02032317,-0.02049568,0.03200473,0.01339339,-0.0483939,-0.0092523,-0.02408889,0.01641988,0.0506563,-0.00473404,0.02973586,0.03023453,-0.0187389,0.01168917,0.01983826,0.08980881,-0.01466317,-0.03557365,-0.02126998,0.01366942,-0.11145718,0.15182957,-0.04555514,-0.00251545,0.00595947,-0.01026107,0.02784228,-0.08511