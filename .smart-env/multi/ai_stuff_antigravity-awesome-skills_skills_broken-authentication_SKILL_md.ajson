iting, try older versions:#{1}":[268,269],"#Older API versions may lack security controls":[270,271],"#Using Burp for OTP testing":[272,282],"#Using Burp for OTP testing#{1}":[273,282],"#Forced enrollment":[283,286],"#Forced enrollment#{1}":[284,286],"#Recovery process":[287,296],"#Recovery process#{1}":[288,296],"#Token security":[297,305],"#Token security#{1}":[298,305],"#Token manipulation":[306,307],"#Token manipulation#{1}":[307,307],"#Try changing user parameter while using valid token":[308,309],"#Host header injection":[310,313],"#Host header injection#{1}":[311,313],"#Reset email may contain attacker's domain":[314,334],"#Reset email may contain attacker's domain#{1}":[315,334],"#Default credentials":[335,342],"#Default credentials#{1}":[336,342],"#Common passwords":[343,351],"#Common passwords#{1}":[344,351],"#Breached credential databases":[352,406],"#Breached credential databases#{1}":[353,406],"#Step 1: Identify lockout threshold":[407,407],"#Try 5 wrong passwords for admin account":[408,408],"#Result: \"Account locked for 30 minutes\"":[409,410],"#Step 2: Test bypass via IP rotation":[411,411],"#Use X-Forwarded-For header":[412,416],"#Use X-Forwarded-For header#{1}":[413,416],"#Increment IP for each attempt":[417,418],"#Increment IP for each attempt#{1}":[418,418],"#Continue until successful or confirmed blocked":[419,420],"#Step 3: Test bypass via case manipulation":[421,423],"#Step 3: Test bypass via case manipulation#{1}":[422,423],"#Some systems treat these as different accounts":[424,431],"#Some systems treat these as different accounts#{1}":[425,431],"#Step 1: Capture JWT token":[432,434],"#Step 1: Capture JWT token#{1}":[433,434],"#Step 2: Decode and analyze":[435,435],"#Header: {\"alg\":\"HS256\",\"typ\":\"JWT\"}":[436,436],"#Payload: {\"user\":\"test\",\"role\":\"user\"}":[437,438],"#Step 3: Try \"none\" algorithm attack":[439,439],"#Change header to: {\"alg\":\"none\",\"typ\":\"JWT\"}":[440,440],"#Remove signature":[441,443],"#Remove signatur