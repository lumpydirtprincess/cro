、生命体征、化验结果和其他健康指标的变化。识别令人担忧的趋势、改善情况，并提供数据驱动的洞察。当用户询问健康趋势、模式、随时间的变化或\"我的健康状况有什么变化？\"时使用。支持多维度分析（体重/BMI、症状、药物依从性、化验结果、情绪睡眠），相关性分析，变化检测，以及交互式HTML可视化报告（ECharts图表）。","allowed-tools":"Read, Grep, Glob, Write","risk":"unknown","source":"community"},"task_lines":[],"tasks":{},"codeblock_ranges":[[83,112],[118,125],[165,177],[183,195],[201,219],[236,305]]},"smart_blocks:ai stuff/antigravity-awesome-skills/plugins/antigravity-awesome-skills/skills/health-trend-analyzer/SKILL.md#---frontmatter---": {"path":null,"last_embed":{"hash":"16x10pv","at":1779627791114},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04686039,0.02723107,-0.00589717,0.00497646,0.01599477,-0.04893247,0.07048545,0.03791066,-0.05517799,-0.04311242,0.02639253,-0.09213142,-0.00455387,0.05662037,-0.01112265,-0.01388192,0.04988079,0.02102682,-0.0619335,-0.03806693,0.06577802,-0.00472494,0.00505196,-0.05212723,-0.01837826,0.04027674,-0.02602867,-0.0438653,0.00127099,-0.16066253,-0.01681466,-0.02983117,0.06003123,-0.00401414,-0.03433168,0.05845213,-0.06086011,0.02677728,-0.09198202,0.00294131,0.02602981,-0.0084988,-0.00686042,0.01973879,0.03171722,0.01991574,-0.0160818,-0.00546219,-0.0042077,0.01846387,-0.032679,-0.0516695,0.02625511,0.04787049,-0.00744816,-0.06696449,0.06992631,-0.01382281,0.02437456,0.08155626,0.02208985,0.06256802,-0.18931624,0.04524785,-0.01771868,0.00817048,-0.02885011,-0.02467223,0.05893485,0.02054953,0.02107378,0.01119525,-0.0363991,0.05618753,0.02016443,0.02797095,0.00274299,-0.05001145,-0.01302934,-0.00473055,0.06235501,0.03590609,-0.00787981,0.02946189,0.00539996,-0.01915443,0.0015372,-0.00845962,0.06153399,0.02796686,0.00662887,-0.05874356,0.02919158,0.05916996,0.03629088,-0.05321378,0.00753008,0.04214673,-0.05580363,0.12292461,-0.07561722,0.03034427,-0.00249661,-0.00597339,0.02480567,-0.09080798,-0.01314929,-0.07124949,-0.00579957,0.03696801,-0.03539126,0.03518729,0.02938231,-0.03960641,-0.03226888,-0.00060217,0.03048101,-0.01798959,-0.00008037,-0.00182135,-0.02460918,-0.0107558,0.0