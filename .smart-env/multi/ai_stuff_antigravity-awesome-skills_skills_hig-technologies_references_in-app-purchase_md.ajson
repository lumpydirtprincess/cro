
"smart_sources:ai stuff/antigravity-awesome-skills/skills/hig-technologies/references/in-app-purchase.md": {"path":"ai stuff/antigravity-awesome-skills/skills/hig-technologies/references/in-app-purchase.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1kjwruf","at":1779618284210},"class_name":"SmartSource","last_import":{"mtime":1777961476253,"size":35873,"at":1779618284213,"hash":"1kjwruf"},"blocks":{"#---frontmatter---":[1,null]},"outlinks":[{"title":"A sketch of an add button, suggesting the purchase of additional digital assets within an app. The image is overlaid with rectangular and circular grid lines and is tinted blue to subtly reflect the blue in the original six-color Apple logo.","target":"https://docs-assets.developer.apple.com/published/201d9efc48577c3322506c6fec1d57aa/technologies-IAP-intro%402x.png","line":9,"embedded":true},{"title":"In-App Purchase","target":"https://developer.apple.com/documentation/StoreKit/in-app-purchase","line":11},{"title":"Apple Pay","target":"https://developer.apple.com/design/human-interface-guidelines/apple-pay","line":15},{"title":"A screenshot of The Coast game’s in-app purchase store on iPad, featuring a row of five boosts that include lighthouse repairs and a power surge, above a row of five in-game maps with names like World Canals, The Great Lakes, and Famous Bays.","target":"https://docs-assets.developer.apple.com/published/842775b676356f64f170bf778ddcac4f/iap-intro%402x.png","line":30,"embedded":true},{"title":"App Review Guidelines","target":"https://developer.apple.com/app-store/review/guidelines/","line":32},{"title":"Auto-renewable subscriptions","target":"https://developer.apple.com/app-store/subscriptions/","line":32},{"title":"In-app purchase","target":"https://developer.apple.com/in-app-purchase/","line":32},{"title":"Advanced Commerce API","target":"https://developer.apple.com/documentation/AdvancedCommerceAPI","line":36},{"title":"App Store support page","target":"https://developer.apple.com/in-app-purchase/advanced-commerce-api/","line":36},{"title":"Best practices","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Best-practices","line":38},{"title":"Auto-renewable subscriptions","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Auto-renewable-subscriptions","line":40},{"title":"`canMakePayments`","target":"https://developer.apple.com/documentation/StoreKit/AppStore/canMakePayments","line":48},{"title":"Supporting Family Sharing","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Supporting-Family-Sharing","line":52},{"title":"Auto-renewable subscriptions","target":"https://developer.apple.com/app-store/subscriptions/","line":58},{"title":"Providing help with in-app purchases","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Providing-help-with-in-app-purchases","line":62},{"title":"Helping people manage their subscriptions","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Helping-people-manage-their-subscriptions","line":64},{"title":"`beginRefundRequest(for:in:)`","target":"https://developer.apple.com/documentation/StoreKit/Transaction/beginRefundRequest\\(for:in:\\","line":64},{"title":"A partial screenshot of an app’s help screen on iPhone. The Back button is in the top-left of the screen. In a list titled ’How can we help?’ there are the following five help items, each of which can open a new screen: Missing a Purchase, Frequently Asked Questions, Request a Refund, Submit Feedback, and Contact Us.","target":"https://docs-assets.developer.apple.com/published/44193c071a05fe28f61658f9e37204f2/custom-purchase-help%402x.png","line":68,"embedded":true},{"title":"A partial screenshot of an app’s refund screen titled Request a Refund on iPhone. The Back button in the top-left of the screen is labeled 'Help' to indicate it takes people back to the help screen. In a list titled Purchases, the screen displays the following three recent purchases: Power Surge, Les Cheneaux Islands, and Cape Cod.","target":"https://docs-assets.developer.apple.com/published/3c43b3f13901fd62f0b6e33ef423bccb/custom-refund-request%402x.png","line":74,"embedded":true},{"title":"A screenshot of the system-provided refund-request sheet on iPhone. The title Request Refund appears in the top center and a close button is in the top right. Below the title, the sheet displays the following information about the refund item: an image of a lighthouse, the title Power Surge for The Coast, the cost $2.99, the purchase date June 5, 2023, and the Apple Account chavez four at iCloud dot com. Below the item information, the sheet lists the following five issues to choose from: I didn’t mean to buy this, A child/minor made purchase without permission, My purchase does not work as expected, Purchase not received, and Other. A checkmark appears next to My purchase does not work as expected. Below the list is the statement ’You may lose access to refunded items’ and a Request Refund button at the bottom of the sheet.","target":"https://docs-assets.developer.apple.com/published/b250a6bd0c37753634151f9684b8fb56/system-refund-flow-1%402x.png","line":80,"embedded":true},{"title":"A screenshot of the system-provided confirmation sheet on iPhone, which displays a checkmark icon and the title ’Your request has been submitted.’ Below the title, the sheet displays the following text: 'You’ll receive an email at chavez four at iCloud dot com with a status update within 48 hours. To check the status of claims, go to https report a problem dot Apple dot com.' A Done button appears at the bottom of the sheet.","target":"https://docs-assets.developer.apple.com/published/a19a34e3ab18f32175e03f2dd227cd60/system-refund-flow-2%402x.png","line":82,"embedded":true},{"title":"Request a refund for apps or content that you bought from Apple","target":"https://support.apple.com/en-us/HT204084","line":84},{"title":"Auto-renewable subscriptions","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Auto-renewable-subscriptions","line":86},{"title":"Making signup effortless","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Making-signup-effortless","line":88},{"title":"Onboarding","target":"https://developer.apple.com/design/human-interface-guidelines/onboarding","line":88},{"title":"A screenshot of the Wave Journal app running on iPhone. The bottom half of the screen includes a highlighted area with the first of five pages that describe the benefits of subscribing, a Try It Free button, and a Sign In button.","target":"https://docs-assets.developer.apple.com/published/84b9d8763a621f9983c223e0a06d8d3d/iphone-onboarding%402x.png","line":90,"embedded":true},{"title":"A screenshot of a page titled Upgrade to Pro on a freemium app running on iPhone. The top half of the screen describes pro features and includes a close button in the top right. The bottom half of the screen shows two subscription options: the Annual Plan, which costs $29.99 per year, comes with a 1-week free trial period, and is a savings of 50% over the monthly plan; and a Monthly Plan that costs $4.99 per month. A checkmark appears next to the Annual Plan subscription. The bottom of the screen includes a Try It Free button.","target":"https://docs-assets.developer.apple.com/published/592286b7e427356873de8605db5836f3/freemium-app%402x.png","line":102,"embedded":true},{"title":"A screenshot of a metered paywall app running on iPhone that offers free viewing of a limited number of articles per month. The screen includes a message indicating that the reader has reached the free article limit for the month, above a button with the title See Your Options. The bottom of the screen includes an option to sign in as an existing subscriber.","target":"https://docs-assets.developer.apple.com/published/cd8631333afb08ae643a553aa484392d/paywall-meter%402x.png","line":104,"embedded":true},{"title":"A screenshot of the Wave Journal app running on iPhone. The bottom half of the screen includes a highlighted Try It Free button.","target":"https://docs-assets.developer.apple.com/published/a66594e715ba9809c02ff2843dbc32d4/iphone-free-trial%402x.png","line":106,"embedded":true},{"title":"Making signup effortless","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Making-signup-effortless","line":112},{"title":"A screenshot of the Forest Explorer app running on iPhone. The screenshot displays a forested area as the first of three images in the top half of the screen. Below the image are three buttons with subscription options: Intrepid Pro, which costs $14.99 per month; Intrepid Pro with Ads, which costs $9.99 per month; and Redeem Code.","target":"https://docs-assets.developer.apple.com/published/7a5f5cdc4159bb6dcc1cd7cb56a98267/iphone-upgrade%402x.png","line":135,"embedded":true},{"title":"A screenshot of the Ocean Journal app running on Apple Watch, and displaying a modal view that describes a benefit of subscribing. Below the description area is a Subscribe Now button with subscription terms below it.","target":"https://docs-assets.developer.apple.com/published/8057a7f6c9b89ff6820aea77d919a408/watch-onboarding%402x.png","line":139,"embedded":true},{"title":"Supporting offer codes","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Supporting-offer-codes","line":143},{"title":"redemption URL","target":"https://developer.apple.com/help/app-store-connect/manage-subscriptions/set-up-offer-codes/#distribute-offer-codes","line":149},{"title":"Providing subscription offers","target":"https://developer.apple.com/app-store/subscriptions/#providing-subscription-offers","line":156},{"title":"Offer codes","target":"https://developer.apple.com/documentation/storekit/implementing-offer-codes-in-your-app","line":156},{"title":"Set up offer codes","target":"https://developer.apple.com/help/app-store-connect/manage-subscriptions/set-up-offer-codes","line":156},{"title":"`presentOfferCodeRedeemSheet(in:)`","target":"https://developer.apple.com/documentation/StoreKit/AppStore/presentOfferCodeRedeemSheet\\(in:\\","line":164},{"title":"`offerCodeRedemption(isPresented:onCompletion:)`","target":"https://developer.apple.com/documentation/SwiftUI/View/offerCodeRedemption\\(isPresented:onCompletion:\\","line":164},{"title":"A screenshot of the Forest Explorer app’s subscription sign-up page on iPhone. The Redeem Code button is highlighted out of the three subscription buttons.","target":"https://docs-assets.developer.apple.com/published/d9787d1349b4d5b6a524d8a5debc4e44/iphone-custom-redeem%402x.png","line":166,"embedded":true},{"title":"A screenshot of an app’s subscription settings screen on iPhone. It includes the app name, subscription level, price, and next billing date, above buttons for Manage Subscription, Restore Purchase, and Redeem Code.","target":"https://docs-assets.developer.apple.com/published/dd8be196f4f16567a2db77fcacce2784/subscription-management%402x.png","line":168,"embedded":true},{"title":"An illustration representing a code redemption screen on iPhone. The top of the screen contains a large icon area above the label Redeem Code and a text field containing placeholder text that says Enter Code. The bottom of the screen contains a tappable link to view Terms and Conditions.","target":"https://docs-assets.developer.apple.com/published/5804d3dd4239644341f2e78fd38fb62e/system-provided-redemption-1%402x.png","line":172,"embedded":true},{"title":"An illustration representing a code redemption screen on iPhone. The top of the screen contains a photo area. A small icon overlaps some of the lower-left corner of the photo area. Below the photo area is the label Offer Name in large text, and below the label is small text that reads '1 month free, then $4.99 per month.' The bottom of the screen contains a Redeem Offer button and a tappable link to view Terms and Conditions.","target":"https://docs-assets.developer.apple.com/published/365222311809b58c9e80d8462f137d1f/system-provided-redemption-3%402x.png","line":174,"embedded":true},{"title":"Promoting your in-app purchases","target":"https://developer.apple.com/app-store/promoting-in-app-purchases/","line":176},{"title":"Helping people manage their subscriptions","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Helping-people-manage-their-subscriptions","line":180},{"title":"A screenshot of an app’s subscription settings screen on iPhone. It includes the app name, subscription level, price, and next billing date, above buttons for Manage Subscription, Restore Purchase, and Redeem Code.","target":"https://docs-assets.developer.apple.com/published/dd8be196f4f16567a2db77fcacce2784/subscription-management%402x.png","line":184,"embedded":true},{"title":"`Product.SubscriptionInfo`","target":"https://developer.apple.com/documentation/StoreKit/Product/SubscriptionInfo","line":186},{"title":"`showManageSubscriptions(in:)`","target":"https://developer.apple.com/documentation/StoreKit/AppStore/showManageSubscriptions\\(in:\\","line":188},{"title":"A screenshot of an app’s subscription management screen on iPhone. It includes the app name, subscription level, price, and next billing date, above a list of subscription options and a Cancel Subscription button.","target":"https://docs-assets.developer.apple.com/published/ea9b497104cc62f2db2bdb539eecca6b/system-cancel-flow-1%402x.png","line":190,"embedded":true},{"title":"A screenshot of an app’s subscription management screen on iPhone. An alert in the center of the screen asks for confirmation to cancel the subscription. The alert includes the text: Confirm Cancellation. If you confirm and cancel your subscription now, you can still access it until July 2023. The alert includes Not Now and Confirm buttons.","target":"https://docs-assets.developer.apple.com/published/b9bf428278819948a07d4297ec7f9649/system-cancel-flow-2%402x.png","line":192,"embedded":true},{"title":"A screenshot of a resubscribe screen in the Math School app running on iPhone. The bottom half of the screen includes the label Resubscribe to Math School in large text, and the first of five pages which describe benefits of resubscribing. Below the page view area is a Resubscribe Now button with a six-month resubscription offer at 50 percent off, and a Sign In button.","target":"https://docs-assets.developer.apple.com/published/72ac419f0368a58ac5f36dba3b3c8a85/promotional-offer%402x.png","line":196,"embedded":true},{"title":"offer codes","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Supporting-offer-codes","line":200},{"title":"Platform considerations","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Platform-considerations","line":202},{"title":"watchOS","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#watchOS","line":206},{"title":"Making signup effortless","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Making-signup-effortless","line":208},{"title":"A screenshot of an app running on Apple Watch. The screen includes text that reads: Intrepid Pro. Unlock 90,000 topographic maps, advanced GPS features, and offline access for trail guidance anywhere. A Close button appears in the top-left corner of the screen.","target":"https://docs-assets.developer.apple.com/published/00bc22f23ed8cc2eb6be337decc3af7b/clarify-description-before%402x.png","line":212,"embedded":true},{"title":"A screenshot of an app running on Apple Watch. The screen includes text that reads: Intrepid Pro. Use advanced GPS features for trail guidance on Apple Watch. Unlock 90,000 topographic maps for use on iPhone and other devices. A Close button appears in the top-left corner of the screen.","target":"https://docs-assets.developer.apple.com/published/ee0a650637153e7fd6506555082cca8c/clarify-description-after%402x.png","line":216,"embedded":true},{"title":"A screenshot of an app running on Apple Watch. The screen includes two subscription buttons: $4.99 per month and $29.99 per year. A Close button appears in the top-left corner of the screen.","target":"https://docs-assets.developer.apple.com/published/d1beed8e9dddac07a14bd09ed184a984/lock-up-option-information%402x.png","line":231,"embedded":true},{"title":"A screenshot of an app running on Apple Watch. The screen includes a list of subscription options: $4.99 billed monthly and $29.99 billed yearly. The $29.99 option is selected. A $29.99 per year button appears at the bottom of the screen, and a Close button appears in the top-left corner of the screen.","target":"https://docs-assets.developer.apple.com/published/2c6e9ab3b201604f462d49cbd3473813/list-option-information%402x.png","line":235,"embedded":true},{"title":"Resources","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Resources","line":239},{"title":"Related","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Related","line":241},{"title":"In-App Purchase","target":"https://developer.apple.com/in-app-purchase/","line":243},{"title":"Offering Subscriptions","target":"https://developer.apple.com/app-store/subscriptions/","line":245},{"title":"App Review Guidelines","target":"https://developer.apple.com/app-store/review/guidelines/","line":247},{"title":"Developer documentation","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Developer-documentation","line":249},{"title":"In-App Purchase","target":"https://developer.apple.com/documentation/StoreKit/in-app-purchase","line":251},{"title":"Videos","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Videos","line":253},{"title":"![","target":"https://devimages-cdn.apple.com/wwdc-services/images/C03E6E6D-A32A-41D0-9E50-C3C6059820AA/9F28A37E-92AA-46D7-8805-8A7CDE31F9E8/9154_wide_250x141_1x.jpg","line":255},{"title":"Change log","target":"https://developer.apple.com/design/human-interface-guidelines/in-app-purchase#Change-log","line":257}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ai stuff/antigravity-awesome-skills/skills/hig-technologies/references/in-app-purchase.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"0","at":1779618284210},"key":"ai stuff/antigravity-awesome-skills/skills/hig-technologies/references/in-app-purchase.md#---frontmatter---","lines":[1,null],"size":0,"outlinks":[],"class_name":"SmartBlock"},

