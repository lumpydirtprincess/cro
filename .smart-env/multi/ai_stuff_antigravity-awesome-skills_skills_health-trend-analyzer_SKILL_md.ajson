变化或\"我的健康状况有什么变化？\"时使用。支持多维度分析（体重/BMI、症状、药物依从性、化验结果、情绪睡眠），相关性分析，变化检测，以及交互式HTML可视化报告（ECharts图表）。","allowed-tools":"Read, Grep, Glob, Write","risk":"unknown","source":"community"},"task_lines":[],"tasks":{},"codeblock_ranges":[[83,112],[118,125],[165,177],[183,195],[201,219],[236,305]]},"smart_blocks:ai stuff/antigravity-awesome-skills/skills/health-trend-analyzer/SKILL.md#---frontmatter---": {"path":null,"last_embed":{"hash":"16x10pv","at":1779620716458},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04398951,0.03098975,-0.00492304,0.00920536,0.02665628,-0.04867941,0.0808881,0.02882154,-0.05745288,-0.03829755,0.03152002,-0.09884255,-0.00149237,0.05876447,-0.01562517,-0.01625792,0.04838115,0.01379808,-0.05042306,-0.03637871,0.05575831,-0.00269567,-0.00280085,-0.05248025,-0.01806284,0.03860615,-0.02755572,-0.0464986,-0.00419367,-0.15349267,-0.01312407,-0.0243236,0.06285458,-0.00567505,-0.0316489,0.05491302,-0.05466053,0.03024185,-0.08144549,-0.00751239,0.01544528,-0.01001859,-0.00404712,0.02398082,0.02203483,0.02536423,-0.00942603,0.00328065,-0.00682809,0.01045263,-0.03852481,-0.05266536,0.03085233,0.04485711,0.00013598,-0.06632321,0.07666268,-0.00808436,0.02741069,0.08878766,0.02906217,0.06159225,-0.19410765,0.04148741,-0.0061311,0.00592076,-0.02190885,-0.01903531,0.04934059,0.02364507,0.01674297,0.00928579,-0.02872757,0.05833964,0.01455529,0.02682005,0.00463269,-0.05785362,-0.02445606,-0.00350819,0.05188502,0.05096029,-0.01343326,0.02617704,0.00136764,-0.01097953,-0.00031679,-0.01292827,0.06101797,0.01378122,0.0018998,-0.06440543,0.0259032,0.05770574,0.03614976,-0.06264906,0.01301703,0.0605341,-0.05425799,0.12042767,-0.07907044,0.01957472,-0.00420093,-0.01230101,0.02879962,-0.09479848,-0.0171953,-0.08371163,-0.01531218,0.03512115,-0.03632164,0.03874319,0.02223063,-0.03716582,-0.02352294,-0.01062351,0.03678185,-0.01051547,0.00007893,-0.00742298,-0.01698018,-0.00446523,0.06145841,-0.00960041,0.04137506,-0.02482102,0.02624728,0.09416397,0.07044504,-0.01467576,0.058295